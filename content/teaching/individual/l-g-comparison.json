      "explanation": {
        "strategy": "先圈出每句的比较范围，再检查 heavy 的形式和限定词。",
        "steps": [
          {
            "text": "红箱3 kg，蓝箱2 kg，第一句只比较两个箱子。",
            "reason": "用比较级 heavier，不叠加 more。"
          },
          {
            "text": "第二句在三个箱子中选质量最大的绿箱。",
            "reason": "用最高级 the heaviest；of the three 明确三者范围。"
          }
        ],
        "distractors": [
          {
            "option": "b",
            "reason": "more heavier 重复标记比较级，应为 heavier。"
          },
          {
            "option": "c",
            "reason": "第二句比较三者中的最大值，不能用 the heavier，应为 the heaviest。"
          }
        ],
        "pitfall": "不能看见一张三者图就让每句话都用最高级；每句的实际比较范围可能不同。",
        "visual": {
          "kind": "sentence",
          "title": "两句，两个比较范围",
          "segments": [
