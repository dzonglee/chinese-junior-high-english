.word-process-order{padding:16px;border-radius:20px;background:#fff;color:#24344b}.process-order-slots{display:flex;align-items:center;gap:6px;margin:18px 0}.process-order-slot{flex:1;min-width:0;min-height:96px;padding:12px 6px;border:2px dashed #c1cbe8;border-radius:16px;background:#f2f6ff;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;text-align:center;font-size:16px;overflow-wrap:anywhere}.process-order-slot.filled{border-style:solid;border-color:#4851cd;background:#e9edff}.process-step-number{display:block;width:24px;height:24px;line-height:24px;border-radius:50%;background:#3442b8;color:#fff;font-weight:700}.process-order-arrow{flex:none;font-size:22px;color:#3442b8}.process-order-events,.process-order-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}.process-order-control{flex:1;min-width:90px;min-height:44px;padding:10px;border-radius:12px;border:1px solid #bec9e2;background:#eef2ff;color:#283bad;font-size:15px;line-height:22px}.process-order-control[disabled]{opacity:.5}.process-order-control:focus-visible{outline:3px solid #156faa;outline-offset:3px}.process-order-reading{display:block;margin-top:12px;font-size:14px;line-height:1.6;color:#3e4d6a}

.word-water-pair{padding:16px;border-radius:20px;background:#fff;color:#24344b}.water-pair-sides{display:flex;gap:12px;margin:18px 0}.water-pair-side{flex:1;min-width:0;display:flex;flex-direction:column;align-items:center;gap:10px;text-align:center;font-size:14px}.water-pair-vessel{position:relative;width:100%;max-width:120px;height:128px;overflow:hidden;border:2px solid #4059aa;border-top:1px dashed #9cadd4;border-radius:6px 6px 20px 20px;background:#f0f8ff}.water-pair-fill{position:absolute;bottom:0;left:0;right:0;background:#4fbbec;border-top:2px solid #1586c5}.water-pair-seed{display:block;flex:none;width:18px;height:12px;border-radius:50%;background:#596484;transform:rotate(-20deg)}.water-pair-level{min-height:22px;color:#304697;font-weight:700}.water-pair-choices{display:flex;flex-direction:column;gap:8px;width:100%}.water-pair-control{min-width:44px;min-height:44px;line-height:22px;padding:10px 6px;border-radius:12px;border:1px solid #c0cbe4;background:#f1f4ff;color:#293bab;font-size:15px}.water-pair-control.active{background:#3444c5;border-color:#3444c5;color:#fff}.water-pair-control:focus-visible{outline:3px solid #1574aa;outline-offset:3px}.water-pair-reset{width:100%}.water-pair-reading{display:block;margin-top:12px;font-size:15px;line-height:1.6}

.word-depth-line{padding:16px;border-radius:20px;background:#fff;color:#24344b}.depth-line-section{position:relative;height:170px;margin:16px 0;border-left:12px solid #687d96;border-right:12px solid #687d96;background:#f6f9ff;overflow:hidden}.depth-line-water{position:absolute;top:24px;bottom:24px;left:0;right:0;background:#d9f1fb;border-top:2px solid #68b9d6;border-bottom:2px solid #687d96}.depth-line-surface,.depth-line-bed{position:absolute;left:8px;z-index:2;font-size:13px;color:#32465c}.depth-line-surface{top:0}.depth-line-bed{bottom:0}.depth-line-mark{position:absolute;z-index:1;display:block}.depth-line-group{display:flex;gap:10px;margin:10px 0}.depth-line-control{flex:1;min-width:44px;min-height:44px;line-height:22px;padding:10px 6px;border-radius:12px;border:1px solid #c0cbe4;background:#f1f4ff;color:#293bab;font-size:15px}.depth-line-control.active{background:#3444c5;border-color:#3444c5;color:#fff}.depth-line-control:focus-visible{outline:3px solid #1574aa;outline-offset:3px}.depth-line-reset{width:100%}.depth-line-reading{display:block;margin-top:12px;font-size:15px;line-height:1.6}

.word-shade-panel{padding:16px;border-radius:20px;background:#fff;color:#24344b}.shade-panel-wall{position:relative;height:160px;margin:16px 0;border:2px solid #69768e;border-radius:14px;overflow:hidden}.shade-panel-window{position:absolute;top:24px;left:24px;width:60px;height:76px;border:6px solid #f8fbff;background:#e5f5ff;border-radius:6px;box-shadow:0 3px 8px #132b4b22}.shade-panel-window:before{content:'';position:absolute;top:0;bottom:0;left:calc(50% - 3px);width:6px;background:#f8fbff}.shade-panel-window:after{content:'';position:absolute;left:0;right:0;top:calc(50% - 3px);height:6px;background:#f8fbff}.shade-panel-group{display:flex;gap:10px;margin:10px 0}.shade-panel-control{flex:1;min-width:44px;min-height:44px;line-height:22px;padding:10px 6px;border-radius:12px;border:1px solid #c0cbe4;background:#f1f4ff;color:#293bab;font-size:15px}.shade-panel-control.active{background:#3444c5;border-color:#3444c5;color:#fff}.shade-panel-control:focus-visible{outline:3px solid #1574aa;outline-offset:3px}.shade-panel-reset{width:100%}.shade-panel-reading{display:block;margin-top:12px;font-size:15px;line-height:1.6}

.word-robot-wave{padding:16px;border-radius:20px;background:#fff;color:#24344b}.robot-wave-stage{position:relative;height:210px;margin:16px 0;border-radius:18px;background:#e8f1fc;overflow:hidden}.robot-wave-head{position:absolute;top:25px;left:calc(50% - 35px);width:70px;height:47px;border:3px solid #263858;border-radius:17px;background:#80ded3;display:flex;justify-content:space-evenly;align-items:center}.robot-wave-head i,.robot-wave-eye{width:9px;height:12px;background:#263858;border-radius:50%}.robot-wave-body{position:absolute;left:calc(50% - 40px);top:83px;width:80px;height:70px;border:3px solid #263858;background:#5573da;border-radius:16px;z-index:2}.robot-wave-body:after{content:'';position:absolute;left:30px;top:22px;width:15px;height:15px;background:#80ded3;border-radius:50%}.robot-wave-arm{position:absolute;top:89px;width:17px;height:61px;background:#80ded3;border:3px solid #263858;border-radius:12px;transform-origin:50% 10px}.robot-wave-left{left:calc(50% + 47px)}.robot-wave-right{right:calc(50% + 47px)}.robot-wave-left.waving{transform:rotate(-90deg);animation:robot-left 1.6s ease-in-out infinite alternate}.robot-wave-right.waving{transform:rotate(90deg);animation:robot-right 1.6s ease-in-out infinite alternate}.robot-wave-legs{position:absolute;top:151px;left:calc(50% - 31px);height:30px;width:62px;border-left:19px solid #263858;border-right:19px solid #263858;box-sizing:border-box}.robot-wave-group{display:flex;gap:10px;margin:10px 0}.robot-wave-control{flex:1;min-width:44px;min-height:44px;line-height:22px;padding:10px 6px;border-radius:12px;border:1px solid #c0cbe4;background:#f1f4ff;color:#293bab;font-size:15px}.robot-wave-control.active{background:#3444c5;border-color:#3444c5;color:#fff}.robot-wave-control:focus-visible{outline:3px solid #1574aa;outline-offset:3px}.robot-wave-reset{width:100%}.robot-wave-reading{display:block;margin-top:12px;font-size:15px;line-height:1.6}@keyframes robot-left{from{transform:rotate(-70deg)}to{transform:rotate(-115deg)}}@keyframes robot-right{from{transform:rotate(70deg)}to{transform:rotate(115deg)}}@media(prefers-reduced-motion:reduce){.robot-wave-arm.waving{animation:none}}

@media(max-width:360px){.robot-wave-arm{height:46px}.robot-wave-left{left:calc(50% + 43px)}.robot-wave-right{right:calc(50% + 43px)}}

.robot-wave-stage,.robot-wave-head,.robot-wave-body,.robot-wave-arm,.robot-wave-legs{box-sizing:border-box}
