/* Word-by-word phrase boundaries: touchable words in normal reading order. */
.workshop-world .world-cells.word-selection{display:flex;flex-direction:row;flex-wrap:wrap;gap:6px;align-items:center}
.workshop-world .word-selection .scope-cell{flex:0 0 auto;width:auto;max-width:100%;min-width:44px;min-height:44px;padding:9px 12px;line-height:1.5}
.workshop-world .word-selection .world-label,.workshop-world .word-selection strong{white-space:nowrap;font-size:16px}
.selected-phrase{padding:12px;margin-top:12px;border-radius:12px;background:#fff}
.selected-phrase>span:first-child,.selected-phrase>text:first-child{font-size:12px;color:#65758d}
.selected-phrase strong,.selected-phrase .phrase-text{display:block;margin-top:5px;font-size:18px;color:#2545bd;overflow-wrap:normal;word-break:normal}

.reading-task{margin:12px 0 18px}.reading-task .section-title{font-size:21px;line-height:1.5;display:block;margin:8px 0}.reading-notice{background:#edf3ff;border-radius:20px;padding:18px 12px;margin-bottom:16px}.reading-title{display:block;color:#2847bd;font-size:13px;letter-spacing:1px;font-weight:800}.reading-evidence-list{display:flex;flex-direction:column;gap:10px}.reading-evidence{display:flex;align-items:flex-start;gap:10px;width:100%;min-height:56px;padding:14px 12px;border:2px solid transparent;border-radius:14px;background:#fff;color:#20365c;text-align:left;font-size:16px;line-height:1.6;white-space:normal;overflow-wrap:normal;word-break:normal}.reading-index{flex:0 0 22px;font-size:13px;font-weight:800;color:#526581}.reading-evidence.selected{border-color:#384bce;background:#e5eaff}.reading-evidence.accepted{border-color:#25806a;background:#e6f4ef}.reading-evidence.wrong-evidence{border-color:#ad415c;background:#fde8ee}.reading-progress{display:block;color:#176858;font-weight:700;font-size:13px;margin:12px 0}.reading-conclusion{padding:16px;border-radius:16px;background:#e6f4ef;color:#176858;margin:18px 0;line-height:1.6}

/* Named clue slots show which complementary premises are still missing. */
.reading-route{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin:14px 0}.reading-route-step{display:flex;flex-direction:column;gap:6px;min-width:0;padding:12px 10px;border:2px solid #d8e1f1;border-radius:14px;background:#f3f6fc;color:#526581;line-height:1.5;overflow-wrap:break-word}.reading-route-step strong,.reading-route-step .field-label{font-size:15px;margin:0;color:#263b64}.reading-route-step>span,.reading-route-step>text:last-child{font-size:13px}.reading-route-step.accepted{background:#e6f4ef;border-color:#25806a;color:#176858}

/* Ordered source cards: learners construct the event sequence before its conclusion. */
.source-order { margin-top: 20rpx; }
.source-order-answer { display: grid; gap: 12rpx; margin: 16rpx 0; padding: 16rpx; border-radius: 24rpx; background: #e4e8ff; }
.source-order-step { display: flex; align-items: flex-start; gap: 14rpx; width: 100%; min-height: 88rpx; margin: 0; padding: 20rpx 16rpx; border: 2rpx solid #cbd2f3; border-radius: 18rpx; background: #fff; text-align: left; color: #17223c; font-size: 28rpx; line-height: 1.5; }
.source-order-step > text:nth-child(2), .source-order-step > span:nth-child(2) { flex: 1; min-width: 0; }
.source-order-step > text:last-child, .source-order-step > span:last-child { color: #687493; }
.source-order-empty { display: block; margin: 0; padding: 20rpx; color: #687493; }
.source-order-bank[disabled] { opacity: .45; }
.order-correct { background: #dff2ec; }
.order-correct .source-order-step { border-color: #398370; }

.source-order-step.order-wrong { background: #fff0f3; border-color: #ad3758; }

/* Explicit stacked rule diagrams keep English words readable on phones. */
.workshop-world.world-stacked .world-cells{flex-direction:column;align-items:stretch}.workshop-world.world-stacked .world-cell{flex:initial;padding:14px 12px}.workshop-world.world-stacked .world-connector{transform:rotate(90deg);align-self:center;font-size:22px;line-height:1;height:22px}.workshop-world.world-stacked .world-cell strong,.workshop-world.world-stacked .world-label{overflow-wrap:normal;word-break:normal}
