<template name="exam-panels">
 <block wx:if="{{s.paperCatalog}}">
  <block wx:if="{{s.paperCatalog.detail}}"><view class="paper-preflight"><view class="paper-cover-mark">Aa<text>ORIGINAL PAPER</text></view><text class="section-title">先独立作答，再逐项补好</text><view class="paper-rules"><text>01 开卷后计时</text><text>02 交卷后看解析</text><text>03 作文另行批改</text></view><button wx:if="{{s.paperCatalog.primary}}" class="button primary" data-action="{{s.paperCatalog.primary.id}}" data-value="{{s.paperCatalog.primary.value}}" disabled="{{s.paperCatalog.primary.disabled}}" bindtap="action">{{s.paperCatalog.primary.label}}</button><text wx:if="{{s.paperCatalog.seen}}" class="help">本卷有 {{s.paperCatalog.seen}} 道题已有作答或答案查看记录；重做成绩与首次独立证据分开。</text></view>
   <view class="panel paper-sections"><text class="section-title">试卷安排</text><view wx:for="{{s.paperCatalog.sections}}" wx:key="id" class="paper-section-row"><view><text class="field-label">{{item.title}}</text><text class="help">{{item.count}} 题 · 建议 {{item.minutes}} 分钟</text></view><view><text class="field-label">{{item.marks}} 分</text></view></view><text class="help">预留5分钟检查未答题、标记题和作文细节。</text></view>
  </block>
  <view wx:else class="paper-deck"><button wx:for="{{s.paperCatalog.rows}}" wx:key="id" class="paper-entry" data-action="open-paper" data-value="{{item.id}}" bindtap="action"><view class="paper-number"><text>{{item.grade}}</text><text>{{item.term}}</text></view><view class="paper-entry-body"><text class="eyebrow">原创笔试 · 自编结构</text><text class="field-label">{{item.title}}</text><text>{{item.count}} 题 · {{item.minutes}} 分钟 · {{item.marks}} 分</text><view class="paper-status"><text>{{item.label}}</text><text>→</text></view></view></button><text wx:if="{{!s.paperCatalog.rows.length}}" class="empty-panel">当前条件下还没有试卷。</text></view>
  <text class="paper-scope">{{s.paperCatalog.scope}}</text>
 </block>
 <view wx:if="{{s.paperSession}}" class="paper-session-tools"><view class="row"><text class="eyebrow">本题 {{s.paperSession.marks}} 分 · 已答 {{s.paperSession.answered}}/{{s.paperSession.total}}</text><button class="text-link" data-action="paper-sheet" bindtap="action">{{s.paperSession.sheetOpen ? '收起答题卡' : '答题卡'}}</button></view><button wx:if="{{s.paperSession.canFlag}}" class="paper-flag {{s.paperSession.flagged ? 'selected' : ''}}" data-action="paper-flag" bindtap="action">{{s.paperSession.flagged ? '? 已标记，点此取消' : '? 标记，稍后检查'}}</button>
  <view wx:if="{{s.paperSession.sheetOpen}}" class="answer-sheet"><text class="help">✓ 已答　— 未答　? 已标记</text><view wx:for="{{s.paperSession.groups}}" wx:key="id" wx:for-item="group" class="sheet-group"><text class="field-label">{{group.title}}</text><view class="sheet-numbers"><button wx:for="{{group.items}}" wx:key="id" class="sheet-number {{item.current ? 'current' : ''}} {{item.answered ? 'answered' : ''}}" data-action="jump" data-value="{{item.index}}" bindtap="action">{{item.index+1}} {{item.flagged ? '?' : item.answered ? '✓' : '—'}}</button></view></view></view>
 </view>
 <view wx:if="{{s.paperReport}}" class="panel paper-report"><text class="section-title">按部分看失分</text><button wx:for="{{s.paperReport.sections}}" wx:key="id" class="paper-section-row report-section {{s.paperReport.filter === item.id ? 'selected' : ''}}" data-action="paper-result-filter" data-value="{{item.id}}" bindtap="action"><view><text class="field-label">{{item.title}}</text><text class="help">{{item.writing ? item.reviewed ? '已自查，待人工批改' : '待人工批改' : item.wrong.length+' 题需订正'+(item.unanswered ? ' · '+item.unanswered+' 题未答' : '')}}</text></view><text class="field-label">{{item.writing ? '另评' : item.score+'/'+item.max}}</text></button><view class="tokens"><button class="chip {{s.paperReport.filter === 'wrong' ? 'selected' : ''}}" data-action="paper-result-filter" data-value="wrong" bindtap="action">错题与作文</button><button class="chip {{s.paperReport.filter === 'all' ? 'selected' : ''}}" data-action="paper-result-filter" data-value="all" bindtap="action">全部题目</button></view><text class="help">先说明错因，再补对应课程。隔几天到期重做，检验是否能独立运用。</text></view>
</template>
