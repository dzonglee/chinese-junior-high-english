<template name="actions">
  <view class="actions"><button wx:for="{{items}}" wx:key="index" class="button {{item.tone || 'secondary'}}" data-action="{{item.id}}" data-value="{{item.value}}" bindtap="action" disabled="{{item.disabled || busy}}" loading="{{busy && item.tone === 'primary'}}">{{item.label}}</button></view>
</template>
<view wx:if="{{screen}}" class="app {{screen.tabs.length ? 'with-tabs' : ''}}">
  <view class="top"><button wx:if="{{screen.back}}" class="back" data-action="back" bindtap="action" aria-label="返回">‹</button><view class="top-copy"><text class="eyebrow" wx:if="{{screen.eyebrow}}">{{screen.eyebrow}}</text><text class="page-title">{{screen.title}}</text><text class="muted" wx:if="{{screen.subtitle}}">{{screen.subtitle}}</text></view></view>
  <view wx:if="{{screen.error}}" class="notice error" role="alert">{{screen.error}}</view>
  <view wx:if="{{screen.notice}}" class="notice">{{screen.notice}}</view>
  <view wx:if="{{screen.hero}}" class="hero {{screen.hero.tone}}"><text class="eyebrow">{{screen.hero.eyebrow}}</text><text class="hero-title">{{screen.hero.title}}</text><text class="hero-text">{{screen.hero.text}}</text><image class="hero-art" src="/assets/{{screen.hero.art}}.png" mode="aspectFit" aria-hidden="true"/><template is="actions" data="{{items:screen.hero.actions,busy:screen.busy}}"/></view>
  <view wx:if="{{screen.metrics.length}}" class="metrics"><view wx:for="{{screen.metrics}}" wx:key="label" class="metric"><text class="metric-value">{{item.value}}</text><text class="muted small">{{item.label}}</text></view></view>
  <view wx:if="{{screen.week.length}}" class="week"><view wx:for="{{screen.week}}" wx:key="index" class="day {{item.active ? 'active' : ''}}"><text>{{item.label}}</text><text class="day-dot">{{item.active ? '✓' : '·'}}</text></view></view>
  <view wx:if="{{screen.progress}}" class="progress-block"><view class="row"><text class="eyebrow">{{screen.progress.label}}</text><text class="muted">先独立想一想</text></view><view class="track"><view style="width:{{screen.progress.percent}}%" class="fill"/></view></view>
  <view wx:if="{{screen.fields.length}}" class="panel form"><view wx:for="{{screen.fields}}" wx:key="name" class="field"><text class="field-label">{{item.label}}</text><picker wx:if="{{item.kind === 'select'}}" range="{{item.options}}" range-key="label" value="{{item.selectedIndex}}" data-name="{{item.name}}" bindchange="select"><view class="input picker">{{item.options[item.selectedIndex].label}}<text>⌄</text></view></picker><picker wx:elif="{{item.kind === 'date'}}" mode="date" value="{{item.value}}" data-name="{{item.name}}" bindchange="date"><view class="input picker">{{item.value || '暂不填写'}}<text>⌄</text></view></picker><textarea wx:elif="{{item.kind === 'textarea'}}" class="input textarea" value="{{item.value}}" placeholder="{{item.placeholder}}" data-name="{{item.name}}" bindinput="input" maxlength="{{item.maxLength || 5000}}" auto-height="{{true}}"/><input wx:else class="input" value="{{item.value}}" type="{{item.numeric ? 'number' : 'text'}}" placeholder="{{item.placeholder}}" data-name="{{item.name}}" bindinput="input" maxlength="{{item.maxLength || 5000}}"/><button wx:if="{{item.kind === 'date' && item.value}}" class="button quiet" data-action="clear-date" bindtap="action">清除日期</button><text wx:if="{{item.help}}" class="help">{{item.help}}</text></view></view>
  <view wx:if="{{screen.word}}" class="panel word-card"><text class="eyebrow">看释义，自己拼一遍</text><text class="word-meaning">{{screen.word.meaning}}</text><text class="passage">{{screen.word.example}}</text><text class="muted">{{screen.word.exampleMeaning}}</text><input class="input answer-input" data-name="wordAnswer" value="{{screen.word.answer}}" placeholder="写出英文单词" bindinput="input" disabled="{{screen.word.revealed}}"/><view wx:if="{{screen.word.revealed}}" class="feedback"><text class="word-answer">{{screen.word.word}}</text><button wx:if="{{screen.word.audioAvailable}}" class="button secondary" data-action="play" data-value="{{screen.word.mediaId}}" bindtap="action">听发音与例句</button><text>{{screen.word.feedback}}</text><text class="muted">{{screen.word.explanation}}</text></view></view>
  <view wx:if="{{screen.question}}" class="panel question"><text class="question-stem">{{screen.question.stem}}</text><text wx:if="{{screen.question.passage}}" class="passage">{{screen.question.passage}}</text>
    <button wx:if="{{screen.question.audioAvailable}}" class="button secondary" data-action="play-current" bindtap="action">▶ 播放音频</button>
    <view wx:if="{{screen.question.recordingAvailable && !screen.question.checked}}" class="recording-controls"><button class="button {{screen.question.recording ? 'danger' : 'secondary'}}" data-action="{{screen.question.recording ? 'record-stop' : 'record-start'}}" bindtap="action">{{screen.question.recording ? '■ 结束并保存录音' : '● 录制我的回答'}}</button><text class="help">{{screen.question.recordingSaved ? '录音已保存，可在“我的录音”回听。' : '录音只保存在本机，最长 60 秒。'}}</text></view>
    <view wx:if="{{screen.question.kind === 'choice'}}" class="options"><button wx:for="{{screen.question.options}}" wx:key="id" class="option {{item.selected ? 'selected' : ''}} {{item.state}}" data-action="choose" data-value="{{item.id}}" bindtap="action" disabled="{{screen.question.checked}}"><text class="option-letter">{{item.id}}</text><text>{{item.text}}</text></button></view>
    <view wx:elif="{{screen.question.kind === 'order'}}"><text class="help">点词组排列；点上面的词组可以撤回。</text><view class="ordered"><button wx:for="{{screen.question.orderedTokens}}" wx:key="id" class="token selected" data-action="order-remove" data-value="{{item.id}}" bindtap="action" disabled="{{screen.question.checked}}">{{item.text}}</button><text wx:if="{{!screen.question.orderedTokens.length}}" class="muted">你的句子会出现在这里</text></view><view class="tokens"><button wx:for="{{screen.question.tokens}}" wx:key="id" class="token" data-action="order-add" data-value="{{item.id}}" bindtap="action" disabled="{{item.selected || screen.question.checked}}">{{item.text}}</button></view></view>
    <textarea wx:elif="{{screen.question.selfReview}}" class="input textarea composition" value="{{screen.question.value}}" data-name="answer" bindinput="input" maxlength="5000" auto-height="{{true}}" disabled="{{screen.question.answerLocked}}" placeholder="写下自己的版本，或记下口语表达要点。草稿会保存在本机。"/><input wx:else class="input answer-input" value="{{screen.question.value}}" data-name="answer" bindinput="input" disabled="{{screen.question.answerLocked}}" placeholder="先写下你的答案" maxlength="5000"/>
    <text wx:if="{{screen.question.selfReview}}" class="help">{{screen.question.words}} 个英文词 · 按要点自查，不是机器评分</text>
    <view wx:if="{{screen.question.hint}}" class="notice">{{screen.question.hint}}</view>
    <view wx:if="{{screen.question.selfReview}}" class="rubric"><text class="section-title">对照要点，自查完成情况</text><button wx:for="{{screen.question.rubric}}" wx:key="id" class="rubric-point {{item.selected ? 'selected' : ''}}" data-action="toggle-rubric" data-value="{{item.id}}" bindtap="action" disabled="{{screen.question.checked}}"><text class="check">{{item.selected ? '✓' : '○'}}</text><view><text class="field-label">{{item.label}} · {{item.marks}} 分</text><text class="help">{{item.guidance}}</text></view></button></view>
    <view wx:if="{{screen.question.feedback}}" class="feedback"><text class="section-title">{{screen.question.feedback}}</text><text class="model-answer">{{screen.question.modelAnswer}}</text></view>
  </view>
  <view wx:if="{{screen.question.explanation}}" class="panel explanation"><text class="eyebrow">把依据讲清楚</text><text class="section-title">思路</text><text>{{screen.question.explanation.strategy}}</text><view wx:for="{{screen.question.explanation.steps}}" wx:key="index" class="step"><text class="step-number">{{index+1}}</text><view><text class="field-label">{{item.text}}</text><text class="muted">{{item.reason}}</text></view></view><view class="diagram"><text class="field-label">{{screen.question.explanation.visual.title}}</text><view class="diagram-segments"><view wx:for="{{screen.question.explanation.visual.segments}}" wx:key="index" class="segment {{item.role}}"><text>{{item.text}}</text><text wx:if="{{item.note}}" class="small">{{item.note}}</text></view></view><text class="help">{{screen.question.explanation.visual.caption}}</text></view><view wx:for="{{screen.question.explanation.distractors}}" wx:key="option" class="distractor"><text class="field-label">为什么不选 {{item.option}}</text><text class="muted">{{item.reason}}</text></view><text class="field-label">容易错在哪里</text><text>{{screen.question.explanation.pitfall}}</text><text class="field-label">下次试试</text><text>{{screen.question.explanation.transfer}}</text></view>
  <view wx:if="{{screen.chips.length}}" class="chips"><button wx:for="{{screen.chips}}" wx:key="id" class="chip {{item.selected ? 'selected' : ''}}" data-action="{{item.action}}" data-value="{{item.value}}" bindtap="action">{{item.label}}</button></view><template is="actions" data="{{items:screen.actions,busy:screen.busy}}"/>
  <view class="cards"><view wx:for="{{screen.cards}}" wx:key="id" class="panel card {{item.tone}}"><view class="card-top"><text wx:if="{{item.character}}" class="character">{{item.character}}</text><view class="card-copy"><text wx:if="{{item.label}}" class="eyebrow">{{item.label}}</text><text class="section-title">{{item.title}}</text></view><text wx:if="{{item.tag}}" class="tag">{{item.tag}}</text></view><text wx:if="{{item.text}}" class="muted card-text">{{item.text}}</text><view wx:if="{{item.progress !== undefined}}" class="track"><view class="fill" style="width:{{item.progress}}%"/></view><template is="actions" data="{{items:item.actions,busy:screen.busy}}"/></view></view>
  <view wx:for="{{screen.sections}}" wx:key="title" class="panel"><text class="section-title">{{item.title}}</text><text class="muted">{{item.text}}</text></view>
  <view wx:if="{{screen.tabs.length}}" class="tabbar"><button wx:for="{{screen.tabs}}" wx:key="id" class="tab {{item.selected ? 'selected' : ''}}" data-action="navigate" data-value="{{item.id}}" bindtap="action"><text class="tab-icon">{{item.character}}</text><text>{{item.label}}</text></button></view>
</view><view wx:else class="loading">正在整理你的学习记录…</view>

<view wx:if="{{privacyPrompt}}" class="privacy-overlay"><view class="panel privacy-dialog"><text class="section-title">隐私保护说明</text><text class="muted">录音用于回听自己的口语练习。学习记录、草稿、私人题目和录音保存在本机；只有你主动操作时才导入或导出备份。请阅读隐私保护指引后决定是否继续。</text><button class="button quiet" bindtap="openPrivacy">阅读隐私保护指引</button><view class="actions"><button class="button quiet" bindtap="declinePrivacy">暂不使用</button><button id="privacy-agree" class="button primary" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="agreePrivacy">同意并继续</button></view></view></view>
