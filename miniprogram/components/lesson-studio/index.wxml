<import src="./workshop.wxml"/>
<import src="./mission.wxml"/>
<template name="task">
 <block wx:if="{{view.workbench}}"><text class="section-title">把词放进句子，试试看</text><text class="help">{{view.workbench.prompt}}</text><view class="sentence-workbench"><text class="sentence-part">{{view.workbench.before}}</text><text class="sentence-slot">{{view.workbench.selection}}</text><text class="sentence-part">{{view.workbench.after}}</text></view></block><text wx:else class="section-title">{{task.stem}}</text>
 <block wx:if="{{task.passage}}"><button class="button quiet" data-action="studio-passage" bindtap="action">{{view.progress.checked.passage ? '收起原文' : '打开原文，先读一读'}}</button><scroll-view wx:if="{{view.progress.checked.passage}}" scroll-y class="studio-reading"><text class="passage">{{task.passage}}</text></scroll-view></block>
 <view wx:if="{{task.kind === 'choice'}}" class="options"><button wx:for="{{task.options}}" wx:key="id" class="option {{view.answer === item.id ? 'selected' : ''}}" data-action="studio-answer" data-value="{{item.id}}" bindtap="action" disabled="{{busy}}"><text class="option-letter">{{item.id}}</text><text>{{item.text}}</text></button></view>
 <block wx:elif="{{task.kind === 'order'}}"><text class="help">点选词块组成回答；点上方词块撤回。</text><view class="ordered"><button wx:for="{{view.responseOrder}}" wx:key="id" class="token selected" data-action="studio-response-remove" data-value="{{item.id}}" bindtap="action">{{item.text}}</button></view><view class="tokens"><button wx:for="{{view.responseTiles}}" wx:key="id" class="token" disabled="{{item.selected || busy}}" data-action="studio-response-add" data-value="{{item.id}}" bindtap="action">{{item.text}}</button></view></block>
 <textarea wx:elif="{{task.kind === 'writing' || task.kind === 'speaking'}}" class="input textarea composition" value="{{view.answer}}" data-name="studioAnswer" bindinput="input" maxlength="5000" placeholder="用自己的话先写草稿或表达提纲；完整表达在课后练习继续。"/>
 <input wx:else class="input answer-input" value="{{view.answer}}" data-name="studioAnswer" bindinput="input" maxlength="5000" placeholder="先试着写出你的表达"/>
 <view wx:if="{{view.progress.step === 4 && (task.kind === 'writing' || task.kind === 'speaking')}}" class="rubric"><text class="help">用自己的话写至少{{view.productionMinimum}}个英文词，再逐项自查。这里记录自评，不自动判断内容。</text><button wx:for="{{view.rubric}}" wx:key="id" class="rubric-point {{item.selected ? 'selected' : ''}}" data-action="studio-rubric" data-value="{{item.id}}" bindtap="action"><text>{{item.selected ? '✓' : '○'}} {{item.label}}</text><text class="help">{{item.guidance}}</text></button></view>
 <button class="button secondary studio-check" data-action="studio-check" bindtap="action" disabled="{{busy}}">{{view.progress.step === 0 ? '记录预测，再去探索' : task.kind === 'writing' || task.kind === 'speaking' ? '记录我的自查' : '核对语境和表达'}}</button>
 <view wx:if="{{view.checked}}" class="explore-feedback {{view.correct ? 'correct' : ''}}"><text>{{view.feedback}}</text><button class="button quiet" data-action="studio-explanation" bindtap="action">{{view.progress.checked.explanation ? '收起参考与图解' : '查看参考与图解'}}</button><scroll-view wx:if="{{view.progress.checked.explanation}}" scroll-y class="studio-reading"><text class="model-answer">{{task.answer.display}}</text><text class="help">{{task.explanation.steps[0].reason}}</text><view class="diagram"><text class="field-label">{{task.explanation.visual.title}}</text><view class="diagram-segments"><view wx:for="{{task.explanation.visual.segments}}" wx:key="index" class="segment {{item.role}}"><text>{{item.text}}</text><text class="small">{{item.note}}</text></view></view><text class="help">{{task.explanation.visual.caption}}</text></view><text class="help">{{task.explanation.pitfall}}</text></scroll-view></view>
</template>
<template wx:if="{{view.mission.open}}" is="visual-mission" data="{{m:view.mission,view:view,busy:busy}}"/>
<view wx:if="{{view && !view.mission.open}}" class="teaching-studio">

 <view wx:if="{{!(view.progress.step === 1 && view.workshop.hasScene)}}" class="exam-focus"><text class="eyebrow">这节课的应试本领</text><text class="field-label">{{view.lesson.coaching.task}}</text><text class="help">{{view.lesson.coaching.check}}</text></view><view class="phase-strip"><text wx:for="{{['预测','动手','应用','批改','迁移']}}" wx:key="index" class="phase-pill {{view.progress.step === index ? 'current' : view.progress.step > index ? 'done' : ''}}">{{index+1}} {{item}}</text></view>
 <view class="panel studio-stage">
 <block wx:if="{{view.progress.step === 0}}">
  <text class="eyebrow">先留下自己的想法，不计独立测验分数</text>
  <block wx:if="{{view.lesson.mode === 'communication'}}"><text class="section-title">{{view.task.stem}}</text><text class="help">先写草稿或表达提纲（至少4个英文词），下一步再看参考表达。口语提纲不能代替实际朗读或录音。</text><textarea class="input textarea composition" value="{{view.progress.before}}" data-name="studioBefore" bindinput="input" maxlength="5000" placeholder="先写自己的版本，暂不看参考表达。"/><button class="button secondary studio-check" data-action="studio-check" bindtap="action">保存初稿，准备比较</button></block>
  <template wx:else is="task" data="{{task:view.task,view:view,busy:busy}}"/>
 </block>
 <block wx:elif="{{view.progress.step === 1}}"><template is="lesson-workshop" data="{{w:view.workshop,busy:busy}}"/></block>
 <block wx:elif="{{view.progress.step === 2}}">
  <block wx:if="{{view.lesson.mode === 'communication'}}">
   <block wx:if="{{!view.revisionEditing}}"><text class="section-title">选一个要点，比较参考写法</text><text class="help">找到一句合适的参考，再实际修改自己的稿子。你可以保留自己的写法。</text>
   <view class="studio-unit-tabs"><button wx:for="{{view.rubric}}" wx:key="id" class="chip {{item.active ? 'selected' : ''}}" data-action="studio-criterion" data-value="{{item.id}}" bindtap="action">要点 {{index+1}}{{item.linked ? ' ✓' : ''}}</button></view><view wx:for="{{view.rubric}}" wx:key="id" wx:for-item="criterion"><view wx:if="{{criterion.active}}" class="revision-criterion"><text class="field-label">{{criterion.label}}</text><text class="help">{{criterion.guidance}}</text><button wx:for="{{view.lesson.modelSentences}}" wx:key="id" class="source-chip {{criterion.linked === item.id ? 'selected' : ''}}" data-action="studio-link" data-value="{{criterion.id+':'+item.id}}" bindtap="action">{{item.text}}</button></view></view>
   <text wx:if="{{view.linkFeedback}}" class="explore-feedback">{{view.linkFeedback}}</text><button class="button quiet" data-action="studio-revision-pane" data-value="write" bindtap="action">去修改自己的草稿</button></block>
   <block wx:else><text class="section-title">现在修改自己的表达</text><text class="help">按原任务完成表达（至少{{view.revisionMinimum}}个英文词），再自查。这里不自动判断内容。</text><button class="button quiet" data-action="studio-revision-pane" data-value="compare" bindtap="action">返回参考表达</button>
   <view class="workshop-reference"><text class="field-label">我的表达计划</text><view wx:for="{{view.planLines}}" wx:key="index"><text class="field-label">{{item.label}}</text><text>{{item.text}}</text></view></view><button class="button quiet" data-action="studio-passage" bindtap="action">对照原任务</button><scroll-view wx:if="{{view.progress.checked.passage}}" scroll-y class="studio-reading"><text class="passage">{{view.lesson.prediction.stem}}</text></scroll-view><text class="field-label">你的原草稿</text><text class="studio-source">{{view.progress.before}}</text><text class="field-label">修改后的草稿或提纲</text><textarea class="input textarea composition" value="{{view.progress.after}}" data-name="studioAfter" bindinput="input" maxlength="5000" placeholder="根据任务要求，实际改动自己的表达。"/><text class="help">{{view.revisionWords}} 个英文词 · {{view.revisionFeedback}}</text>
   <button wx:for="{{view.rubric}}" wx:key="id" class="rubric-point {{item.selected ? 'selected' : ''}}" data-action="studio-rubric" data-value="{{item.id}}" bindtap="action">{{item.selected ? '✓' : '○'}} 我已检查：{{item.label}}</button>
   <button class="button secondary studio-check" data-action="studio-review" bindtap="action">核对修改与自查记录</button><text wx:if="{{view.progress.checked.revision}}" class="help">修改与自查已记录。这是你的自评，不是机器判定内容已经完整。</text>
   </block>
  </block>
  <block wx:elif="{{view.lesson.mode === 'reading' || view.lesson.mode === 'transcript'}}"><text class="section-title">先作答，再用原文支持判断</text><template is="task" data="{{task:view.task,view:view,busy:busy}}"/><view class="studio-unit-tabs"><button wx:for="{{view.contextTabs}}" wx:key="id" class="chip {{view.progress.caseIndex === index ? 'selected' : ''}}" data-action="studio-case" data-value="{{index}}" bindtap="action">{{item.done ? '✓ ' : ''}}问题 {{index+1}}</button></view><view class="tokens"><button wx:for="{{view.evidenceItems}}" wx:key="id" class="chip {{view.progress.answers.source === item.id ? 'selected' : ''}}" data-action="studio-source" data-value="{{item.id}}" bindtap="action">原文 {{index+1}}{{view.progress.answers.evidence === item.id ? ' · 已选' : ''}}</button></view><block wx:for="{{view.evidenceItems}}" wx:key="id"><block wx:if="{{view.progress.answers.source === item.id}}"><scroll-view scroll-y class="studio-reading"><text class="passage">{{item.text}}</text></scroll-view><button class="button secondary" data-action="studio-evidence" data-value="{{item.id}}" bindtap="action">选这段作为依据</button></block></block><text wx:if="{{!view.progress.answers.source}}" class="help">点一个片段，读后再选择依据。</text><text wx:if="{{view.evidenceChecked}}" class="explore-feedback {{view.evidenceCorrect ? 'correct' : ''}}">{{view.evidenceFeedback}}</text></block>
  <block wx:elif="{{view.wordRewrite}}"><text class="section-title">同一个词，换个情境再用一次</text><text class="help">保留目标词，把人物、时间或事情换一个。不要只照抄刚才的句子。</text><view class="studio-unit-tabs"><button wx:for="{{view.contextTabs}}" wx:key="id" class="chip {{view.progress.caseIndex === index ? 'selected' : ''}}" data-action="studio-case" data-value="{{index}}" bindtap="action">{{item.done ? '✓ ' : ''}}{{view.lesson.mission.workshop.items[index].answer}}</button></view><view class="word-meaning"><text class="eyebrow">{{view.wordRewrite.meaning}}</text><text class="section-title">{{view.wordRewrite.word}}</text></view><text class="field-label">我刚才的句子</text><text class="studio-source">{{view.wordRewrite.original}}</text><text class="field-label">换个细节，写一句新的</text><textarea class="input textarea" value="{{view.answer}}" data-name="studioAnswer" bindinput="input" maxlength="1000"/><view class="workshop-reference"><text class="field-label">改完对照这条用法</text><text class="help">{{view.wordRewrite.note}}</text><text>{{view.wordRewrite.example}}</text></view><button class="rubric-point {{view.wordRewrite.selfChecked ? 'selected' : ''}}" data-action="studio-word-review" bindtap="action">{{view.wordRewrite.selfChecked ? '✓' : '○'}} 我已核对词义和搭配</button><button class="button secondary" data-action="studio-check" bindtap="action">保存改写与自查</button><text wx:if="{{view.checked}}" class="explore-feedback {{view.correct ? 'correct' : ''}}">{{view.feedback}}</text></block>
  <block wx:elif="{{view.lesson.sorting}}"><text class="section-title">{{view.lesson.sorting.title}}</text><text class="help">点选分类；每张卡都有即时反馈，可以改选。全部归类正确后再继续。</text><view wx:for="{{view.sortingCards}}" wx:key="id" wx:for-item="card" class="sorting-card"><text class="field-label">{{card.text}}</text><view class="tokens"><button wx:for="{{view.lesson.sorting.categories}}" wx:key="id" class="chip {{card.selected === item.id ? 'selected' : ''}}" data-action="studio-sort" data-value="{{card.id+':'+item.id}}" bindtap="action">{{item.label}}</button></view><text wx:if="{{card.checked}}" class="explore-feedback {{card.correct ? 'correct' : ''}}">{{card.correct ? card.reason : '这个分类还不合适，再对照分类含义试一试。'}}</text></view><text class="help">{{view.lesson.sorting.note}}</text></block>
  <block wx:else><text wx:if="{{!view.workbench}}" class="section-title">换个语境，试试看</text><view class="studio-unit-tabs"><button wx:for="{{view.contextTabs}}" wx:key="id" class="chip {{view.progress.caseIndex === index ? 'selected' : ''}}" data-action="studio-case" data-value="{{index}}" bindtap="action">{{item.done ? '✓ ' : ''}}语境 {{index+1}}</button></view><template is="task" data="{{task:view.task,view:view,busy:busy}}"/><text class="help">每次换一个语境，观察表达的变化。</text></block>
 </block>
 <block wx:elif="{{view.progress.step === 3}}"><text class="eyebrow">考场诊所 · 不只答对，还要会辨错</text><view class="studio-unit-tabs"><button wx:for="{{view.clinicTabs}}" wx:key="id" class="chip {{view.clinicIndex === index ? 'selected' : ''}}" data-action="studio-clinic" data-value="{{index}}" bindtap="action">{{item.done ? '✓ ' : ''}}{{index+1}}</button></view><text class="section-title">{{view.diagnosis.prompt}}</text><block wx:if="{{view.diagnosis.excerpt}}"><button class="button quiet" data-action="studio-explanation" bindtap="action">{{view.progress.checked.explanation ? '收起题目材料' : '打开题目材料'}}</button><scroll-view wx:if="{{view.progress.checked.explanation}}" scroll-y class="studio-reading"><text class="passage">{{view.diagnosis.excerpt}}</text></scroll-view></block><button wx:for="{{view.diagnosis.options}}" wx:key="id" class="option {{view.progress.answers.diagnosis === item.id ? 'selected' : ''}}" data-action="studio-diagnose" data-value="{{item.id}}" bindtap="action">{{item.text}}</button><text wx:if="{{view.checked}}" class="explore-feedback {{view.correct ? 'correct' : ''}}">{{view.feedback}}</text></block>
 <block wx:elif="{{view.progress.step === 4}}"><text class="eyebrow">换一个任务，检验刚才的方法</text><template is="task" data="{{task:view.task,view:view,busy:busy}}"/></block>
 <block wx:else><text class="discovery-mark">✓</text><text class="section-title">这节课的动手探索已记录</text><text>{{view.lesson.objective}}</text><text class="help">搭建、探究、批改和迁移都已完成，但不等于掌握。刚看过的原题只能算巩固；不同的新题和延时复习才检验独立运用。</text><text wx:if="{{view.lesson.mediaPending}}" class="notice">这里只完成文字推演，不记听力完成。实际听力等待批准的音频。</text></block>
 </view>
</view>
