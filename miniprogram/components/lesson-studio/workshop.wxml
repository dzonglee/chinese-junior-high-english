.filled ? 'filled' : ''}}"/></view></view><text class="money-reading" aria-live="polite">{{w.composeBrief.money.reading}}</text><text class="help">{{w.composeBrief.money.note}}</text></view></view><button data-action="studio-workshop-composeBrief" data-value="reset" bindtap="action">重搭这张卡</button><text class="help">{{w.item.hint}}</text></view><view class="compose-task"><text class="eyebrow">{{w.item.readingPlan ? '朗读准备' : '表达计划'}} {{w.index+1}}</text><text class="section-title">{{w.item.label}}</text></view><text class="field-label">{{w.item.readingPlan ? '记下我的朗读准备' : '先写我自己的说法'}}</text><textarea class="input textarea" data-name="studioWorkshopOwn" value="{{w.own}}" bindinput="input" maxlength="1000"/><text class="help">{{w.draftWords}} 个英文词 · {{w.item.readingPlan ? '至少4个词，记下要练的原句、关键词或停顿。这里只保存准备，不检查发音。' : '至少4个英文词，先记具体信息。这里只记录计划，不自动判断内容是否完整。'}}</text><button class="button secondary" data-action="studio-workshop-check" bindtap="action">{{w.item.readingPlan ? '保存这项朗读准备' : '把这句放进我的计划'}}</button></block>
