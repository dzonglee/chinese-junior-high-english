erage" data-value="place:town" aria-pressed="{{w.composeCoverage.townSelected}}" class="{{w.composeCoverage.townSelected?'active':''}}">全镇</button></view><button bindtap="action" class="button quiet" data-action="studio-workshop-composeCoverage" data-value="place:clear">撤回地点</button></view><view class="coverage-control"><text class="field-label">2. 准备概括多久？</text><view class="coverage-options"><button bindtap="action" data-action="studio-workshop-composeCoverage" data-value="time:three" aria-pressed="{{w.composeCoverage.threeSelected}}" class="{{w.composeCoverage.threeSelected?'active':''}}">这三个下午</button><button bindtap="action" data-action="studio-workshop-composeCoverage" data-value="time:year" aria-pressed="{{w.composeCoverage.yearSelected}}" class="{{w.composeCoverage.yearSelected?'active':''}}">全年</button></view><button bindtap="action" class="button quiet" data-action="studio-workshop-composeCoverage" data-value="time:clear">撤回时间</button></view><text class="coverage-selection" aria-live="polite">{{w.composeCoverage.placeText}} · {{w.composeCoverage.timeText}}</text><button bindtap="action" class="button quiet" data-action="studio-workshop-composeCoverage" data-value="reset">重设概括范围</button></view><view wx:if="{{w.composeOrder}}" class="word-process-order compose-order" aria-label="{{w.composeOrder.title}}"><text class="field-label">{{w.composeOrder.title}}</text><text class="help">{{w.composeOrder.hint}}</text><view class="process-order-slots" aria-label="你排的先后"><block wx:for="{{w.composeOrder.slots}}" wx:for-item="slot" wx:key="id"><text wx:if="{{index}}" class="process-order-arrow" aria-hidden="true">→</text><view class="process-order-slot {{slot.filled ? 'filled' : ''}}" data-slot="{{slot.id}}"><text class="process-step-number">{{index+1}}</text><text>{{slot.label}}</text></view></block></view><view class="process-order-events" aria-label="按先后点选事件"><button wx:for="{{w.composeOrder.events}}" wx:key="id" class="process-order-control" disabled="{{item.used}}" d