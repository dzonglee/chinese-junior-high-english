<template name="lesson-workshop">
 <view class="lesson-workshop">
  <text class="eyebrow">动手任务 · {{w.doneCount}} / {{w.total}}</text><block wx:if="{{w.item.sourceStyle !== 'cards'}}"><text class="section-title">{{w.title}}</text><text class="help">{{w.instruction}}</text></block>
  <view wx:if="{{(w.kind === 'transform' || w.item.sourceStyle === 'cards') && w.total > 4}}" class="workshop-tabs scene-pager"><button wx:if="{{w.index > 0}}" class="chip" data-action="studio-workshop-item" data-value="{{w.index-1}}" bindtap="action">← {{w.kind === 'proof' ? '上一题' : '上一项'}}</button><view wx:else/><button class="chip selected" data-action="studio-workshop-item" data-value="{{w.index}}" bindtap="action">{{w.navigationLabel}} {{w.index+1}} / {{w.total}}</button><button wx:if="{{w.index < w.total-1}}" class="chip" data-action="studio-workshop-item" data-value="{{w.index+1}}" bindtap="action">{{w.kind === 'proof' ? '下一题' : '下一项'}} →</button><view wx:else/></view>
  <view wx:else class="workshop-tabs"><button wx:for="{{w.tabs}}" wx:key="id" class="chip {{w.index == item.id ? 'selected' : ''}}" data-action="studio-workshop-item" data-value="{{item.id}}" bindtap="action">{{item.done ? '✓ ' : ''}}{{item.label}}</button></view>
  <block wx:if="{{w.kind === 'transform'}}">
   <view class="workshop-world world-{{w.worldClass}} {{w.condition.world.layout === 'stacked' ? 'world-stacked' : ''}}"><text class="world-caption">{{w.condition.world.caption}}</text>
    <view wx:if="{{w.records}}" class="event-records"><text class="field-label">{{w.records.title}}</text><view wx:if="{{w.records.asset}}" class="event-art-wrap"><image class="event-art {{w.condition.tiles ? 'compact-record-art' : ''}}" src="/{{w.records.assetRoot || 'assets'}}/{{w.records.asset}}.jpg" mode="{{w.condition.tiles ? 'aspectFit' : 'widthFix'}}" aria-label="{{w.records.alt}}"/><text wx:if="{{w.records.overlay}}" class="scene-sign" style="left:{{w.records.overlay.left}}%;top:{{w.records.overlay.top}}%;width:{{w.records.overlay.width}}%;">{{w.records.overlay.text}}</text><button wx:for="{{w.recordArtChoices}}" wx:key="id" class="art-panel-button {{item.selected ? 'selected' : ''}} {{item.wrong ? 'wrong-record' : ''}}" style="{{item.style}}" data-action="studio-workshop-record" data-value="{{item.id}}" bindtap="action" aria-label="{{item.label}}，{{item.text}}"><text>{{item.selected ? '✓ ' : ''}}{{item.label}}</text></button></view><view wx:if="{{w.records.artLabels && !w.recordArtChoices.length}}" class="event-art-labels {{w.records.artLabels.length === 1 ? 'single-caption' : ''}}"><text wx:for="{{w.records.artLabels}}" wx:key="*this">{{item}}</text></view><view class="event-options"><button wx:for="{{w.recordOptions}}" wx:key="id" class="event-record {{item.selected ? 'selected' : ''}} {{item.wrong ? 'wrong-record' : ''}}" data-action="studio-workshop-record" data-value="{{item.id}}" bindtap="action"><text class="event-label">{{item.label}}</text><text class="event-text">{{item.text}}</text></button></view></view>
    <text wx:if="{{w.condition.tiles && !w.scene && !w.morphemeTiles && w.condition.world.selection.mode !== 'words' && !w.sourceOpen}}" class="clause-original">原稿：{{w.condition.world.cells[0].label}}</text>
    <block wx:if="{{!w.condition.tiles || w.scene || w.sourceOpen || w.morphemeTiles || w.condition.world.selection.mode === 'words'}}">
    <block wx:if="{{w.scene}}"><view wx:if="{{w.scene.record}}" class="routine-record"><text class="field-label">{{w.scene.record.title}}</text><view class="routine-days"><view wx:for="{{w.scene.record.days}}" wx:key="label" class="routine-day"><text>{{item.label}}</text><text>{{item.text}}</text></view></view></view><text class="field-label">{{w.scene.selectionPrompt || '① 点人物，圈出主语指谁（可多选）'}}</text><view class="people-scene"><image src="/{{w.scene.assetRoot || 'assets'}}/{{w.scene.asset}}.jpg" mode="aspectFit" class="people-scene-image" aria-label="{{w.scene.alt}}"/><button wx:for="{{w.scenePeople}}" wx:key="id" class="scene-person {{item.selected ? 'selected' : ''}} {{item.wrong ? 'wrong-person' : ''}}" style="{{item.style}}" data-action="studio-workshop-subject" data-value="{{item.id}}" bindtap="action" aria-label="{{item.name}}，{{item.description}}，{{item.selected ? '已圈出' : '未圈出'}}"><text wx:if="{{item.speaking || item.listening}}" class="scene-role">{{item.speaking ? '正在说话' : '正在听'}}</text><text class="scene-name">{{item.selected ? (item.wrong ? '✕ ' : (w.attempted && w.sceneSubjectsCorrect ? '✓ ' : '● ')) : ''}}{{item.name}}</text></button></view></block>
    <view wx:elif="{{w.redaction}}"><text class="field-label">{{w.condition.world.selection.prompt}}</text><view class="redaction-preview"><image class="redaction-image" src="/illustrations/{{w.redaction.asset}}.jpg" mode="widthFix" aria-label="{{w.redaction.alt}}"/><view wx:for="{{w.redaction.regions}}" wx:key="id" class="redaction-field {{item.masked ? 'masked' : ''}} {{item.wrong ? 'needs-redaction-correction' : ''}}" style="{{item.style}}" data-region="{{item.id}}" data-masked="{{item.masked}}" aria-hidden="true"><text>{{item.masked ? '已遮挡' : item.text}}</text></view></view><view class="redaction-controls" aria-label="遮挡演示字段"><button wx:for="{{w.redaction.regions}}" wx:key="id" class="redaction-toggle {{item.masked ? 'selected' : ''}} {{item.wrong ? 'needs-redaction-correction' : ''}}" data-action="studio-workshop-member" data-value="{{item.id}}" bindtap="action" aria-pressed="{{item.masked}}" aria-label="{{(item.masked ? '还原' : '遮挡') + item.label}}"><text class="field-label">{{item.label}}</text><text class="redaction-state">{{item.masked ? '已遮挡 · 点此还原' : '显示中 · 点此遮挡'}}</text></button></view><text class="help">这里只检查背景字段；分享用途与相关人员的许可还要另查。</text></view>
    <view wx:elif="{{w.condition.world.selection}}"><text class="field-label">{{w.condition.world.selection.prompt}}</text><view class="world-cells scope-grid scope-count-{{w.cells.length}} {{w.condition.world.selection.mode === 'words' ? 'word-selection' : w.condition.world.selection.mode === 'fields' ? 'condition-fields' : ''}}"><button wx:for="{{w.cells}}" wx:key="id" class="world-cell scope-cell {{item.selected ? 'selected' : ''}} {{item.wrong ? 'wrong-member' : ''}}" data-action="studio-workshop-member" data-value="{{item.id}}" bindtap="action" aria-label="{{item.label}}，{{item.detail}}，{{item.selected ? '已选中' : '未选中'}}"><view wx:if="{{w.condition.world.selection.mode !== 'words' && w.condition.world.selection.mode !== 'fields'}}" class="scale-rail"><view class="scale-fill" style="width:{{item.value}}%;"/></view><text class="world-label">{{item.selected && w.worldClass !== 'calendar' ? (w.condition.world.selection.mode === 'fields' ? (item.wrong ? '✕ ' : w.attempted && w.membersCorrect ? '✓ ' : '● ') : '✓ ') : ''}}{{item.label}}</text><text wx:if="{{w.condition.world.selection.mode !== 'words'}}" class="world-detail">{{item.detail}}</text></button></view><view wx:if="{{w.condition.world.selection.mode === 'words'}}" class="selected-phrase"><text>圈出的部分</text><text class="phrase-text">{{w.selectionText || '…'}}</text></view></view>
    <view wx:elif="{{w.worldClass === 'position'}}" class="position-room"><text class="position-table">desk</text><text class="position-book" style="top:{{w.cells[0].value}}%;">book</text></view>
    <view wx:elif="{{w.worldClass === 'timeline'}}" class="time-world {{w.records ? 'records-time' : ''}}"><view class="time-axis"><text>过去</text><text class="axis-now">现在</text><text>将来 →</text></view><block wx:for="{{w.cells}}" wx:key="index"><view class="time-track"><view class="time-now"/><view wx:if="{{w.referenceStyle}}" class="time-reference" style="{{w.referenceStyle}}"/><view wx:if="{{item.role}}" class="time-range range-{{item.role}}" style="{{item.rangeStyle}}"/><view class="time-event" style="{{item.style}}"><view class="time-dot"/><text>{{item.label}}</text></view></view><text class="time-note">{{item.detail}}</text></block></view>
    <view wx:elif="{{w.verbBridge}}" class="verb-path {{w.expressionWrong ? 'wrong-bridge' : ''}}" aria-label="动词后面的连接方式"><view class="verb-path-node"><text class="small">动词</text><text class="verb-path-word">{{w.verbBridge.verb}}</text></view><view class="verb-path-middle {{w.verbBridge.known ? 'known' : ''}} {{w.verbBridge.known && !w.verbBridge.link ? 'direct' : ''}}"><block wx:if="{{w.verbBridge.known}}"><text wx:if="{{w.verbBridge.link}}" class="verb-bridge-word">{{w.verbBridge.link}}</text><block wx:else><text class="verb-direct-label">直接接</text><text class="verb-direct-arrow">→</text></block></block><block wx:else><text class="small">先选择</text><text class="verb-unknown">?</text></block></view><view class="verb-path-node"><text class="small">{{w.verbBridge.objectLabel}}</text><text class="verb-path-word">{{w.verbBridge.object}}</text></view></view>
    <view wx:elif="{{w.albumOwnership}}" class="album-scene {{w.attempted && !w.recordCorrect ? 'wrong-ownership' : ''}}" aria-label="旅行相册的所属关系"><text class="field-label">你选的分配方式</text><view class="album-owners"><text wx:for="{{w.albumOwnership.owners}}" wx:key="*this">{{item}}</text></view><block wx:if="{{w.albumMode}}"><view class="album-links {{w.albumMode}}"><view wx:if="{{w.albumMode === 'shared'}}" class="album-join"/><block wx:else><view class="album-stem"/><view class="album-stem"/></block></view><view class="album-objects {{w.albumMode}}"><view wx:for="{{w.albumItems}}" wx:key="label" class="album-tile"><view class="book-figure"/><text>{{item.label}}</text></view></view><text class="album-count">{{w.albumItems.length === 1 ? '共1本，两人共有' : '共2本，每人各1本'}}</text></block><text wx:else class="help">先选所属关系，看看相册怎样分配。</text></view>
    <view wx:else class="world-cells"><block wx:for="{{w.cells}}" wx:key="index" wx:for-item="cell"><text wx:if="{{index > 0 && (w.worldClass === 'roles' || w.worldClass === 'logic' || w.worldClass === 'morphology' || w.worldClass === 'syntax')}}" class="world-connector">{{w.worldClass === 'morphology' ? (w.cells[1].role === 'rewrite' ? (index === 1 ? '→' : '↓') : (index === 1 ? '+' : '=')) : (w.condition.world.connector || '→')}}</text><view class="world-cell {{cell.role === 'subject' ? 'world-subject' : ''}} {{(cell.role === 'attempt-result' && w.expressionWrong) || cell.wrong ? 'needs-correction' : ''}}"><view wx:if="{{w.worldClass === 'count'}}" class="count-objects"><view wx:for="{{cell.copies}}" wx:key="*this" class="count-object count-{{cell.art}}"><text wx:if="{{cell.art === 'bundle'}}">100</text><text wx:if="{{cell.art === 'ten-bundle'}}">10</text><text wx:if="{{cell.art === 'thousand-bundle'}}">1000</text></view><text wx:if="{{cell.uncertain}}">…</text></view><view wx:if="{{w.worldClass === 'scale'}}" class="scale-rail"><view class="scale-fill" style="width:{{cell.value}}%;"/></view><text class="world-label">{{cell.label}}</text><text class="world-detail">{{cell.detail}}</text></view></block></view>
    </block><button wx:if="{{w.condition.tiles && !w.scene && !w.morphemeTiles && w.condition.world.selection.mode !== 'words'}}" class="button quiet" data-action="studio-workshop-source" bindtap="action">{{w.sourceOpen ? '收起词序图' : '看原稿与词序图'}}</button>
   </view><text class="field-label">{{w.scene ? '② 核对' + (w.scene.formLabel || 'be') + '，把话说完整' : '让句子符合当前条件：' + w.condition.label}}</text><view class="workshop-sentence {{w.scene ? 'scene-expression' : ''}} {{w.expressionWrong ? 'needs-repair' : ''}}"><text>{{w.condition.before}}</text><view class="workshop-ending {{w.keepEnding ? 'keep-ending' : ''}}"><view wx:if="{{w.condition.tiles}}" class="workshop-slot workshop-tile-answer tile-clause-slot {{w.morphemeTiles ? 'word-part-answer' : ''}}" aria-label="{{w.morphemeTiles ? '拼出的词' : '拼出的表达'}}"><button wx:for="{{w.tileAnswer}}" wx:key="id" class="token selected" data-action="studio-workshop-tile-remove" data-value="{{item.id}}" bindtap="action">{{item.text}}</button><text wx:if="{{!w.tileAnswer.length}}">…</text></view><text wx:else class="workshop-slot">{{w.selected || '…'}}</text><text class="workshop-end">{{w.condition.after}}</text></view></view>
   <block wx:if="{{w.condition.tiles}}"><text class="field-label">{{w.morphemeTiles ? '可选部件 · 拼成一个词' : '可选词块'}}</text><view class="tokens workshop-tile-bank" aria-label="{{w.morphemeTiles ? '可选部件' : '可选词块'}}"><button wx:for="{{w.tileBank}}" wx:key="id" class="token" data-action="studio-workshop-tile-add" data-value="{{item.id}}" bindtap="action" disabled="{{item.used}}">{{item.text}}</button></view><button class="button quiet" data-action="studio-workshop-tile-clear" bindtap="action">重新拼</button><button class="button quiet" data-action="studio-workshop-reveal" bindtap="action">{{w.revealed ? '遮住参考' : '需要时看参考'}}</button><text wx:if="{{w.revealed}}" class="workshop-reference">{{w.condition.target}}</text></block>
   <block wx:elif="{{w.condition.input}}"><text class="field-label">{{w.condition.initial !== undefined ? '修好原稿中的表达' : '自己写出缺少的表达'}}</text><input class="input answer-input" data-name="studioWorkshopInput" value="{{w.selected}}" bindinput="input" maxlength="120"/><text class="help">{{w.condition.inputHint || '输入会同步到上面的句子。'}}</text><button class="button quiet" data-action="studio-workshop-reveal" bindtap="action">{{w.revealed ? '遮住参考' : '需要时看参考'}}</button><text wx:if="{{w.revealed}}" class="workshop-reference">{{w.condition.target}}</text></block>
   <view wx:else class="tokens"><button wx:for="{{w.choices}}" wx:key="id" class="token {{item.selected ? 'selected' : ''}}" data-action="studio-workshop-choose" data-value="{{item.id}}" bindtap="action">{{item.text}}</button></view><button class="button secondary" data-action="studio-workshop-check" bindtap="action">{{w.redaction ? '核对遮挡与结论' : '核对句子与条件'}}</button>
  </block>
  <block wx:elif="{{w.kind === 'word-use'}}">
   <view wx:if="{{w.item.usage}}" class="usage-world"><text class="help">{{w.item.usage.caption}}</text><view class="usage-people"><text>{{w.item.usage.left}}</text><text>{{w.item.usage.right}}</text></view><view class="usage-track"><text class="usage-arrow">{{w.usageDirection === 'left' ? '←' : w.usageDirection === 'right' ? '→' : '?'}}</text><text class="usage-object object-{{w.usageDirection || 'rest'}}">{{w.item.usage.object}}</text></view><text class="help">方向跟着你输入的词变化；再核对它是否符合情境。</text></view><view class="word-meaning"><text class="eyebrow">从意思到用法</text><text class="section-title">{{w.item.meaning}}</text></view><view class="workshop-sentence"><text>{{w.item.before}}</text><text class="workshop-slot">{{w.input || '…'}}</text><text>{{w.item.after}}</text></view><text class="help">{{w.item.hint}}</text><text class="field-label">遮住词表，自己写</text><input class="input answer-input" data-name="studioWorkshopInput" value="{{w.input}}" bindinput="input" maxlength="120"/>
   <button class="button secondary" data-action="studio-workshop-check" bindtap="action">核对词形</button><button class="button quiet" data-action="studio-workshop-reveal" bindtap="action">{{w.revealed ? '遮住参考' : '需要时看参考'}}</button><view wx:if="{{w.revealed}}" class="workshop-reference"><text class="section-title">{{w.item.answer}}</text><text>{{w.item.material}}</text><text class="help">{{w.item.reason}}</text></view>
   <block wx:if="{{w.correct}}"><text class="field-label">换成我的生活：用这个词写一句</text><textarea class="input textarea" data-name="studioWorkshopOwn" value="{{w.own}}" bindinput="input" maxlength="1000"/><text class="help">{{w.draftWords}} 个英文词 · 核对词义和搭配。机器只检查词形和长度。</text><button class="button secondary" data-action="studio-workshop-save" bindtap="action">保存例句与自查</button></block>
  </block>
  <block wx:elif="{{w.kind === 'proof'}}">
   <block wx:if="{{w.item.sourceStyle === 'cards'}}">
    <view class="reading-task"><text class="eyebrow">{{w.item.label}}</text><text class="section-title">{{w.item.prompt}}</text></view>
    <view wx:if="{{w.proofSteps.length}}" class="reading-route" aria-label="证据链"><view wx:for="{{w.proofSteps}}" wx:for-item="proofStep" wx:key="id" class="reading-route-step {{proofStep.accepted ? 'accepted' : ''}}"><text class="field-label">{{proofStep.label}}</text><text>{{proofStep.accepted ? '✓ 已找到' : '○ 还缺这条'}}</text></view></view>
    <view class="reading-notice"><text class="reading-title">{{w.item.sourceTitle}}</text><view wx:if="{{w.item.sourceArt.layout === 'repeat'}}" class="event-art-wrap source-photo-comparison"><button wx:for="{{w.proofArtChoices}}" wx:key="id" class="art-panel-button {{item.selected || item.accepted ? 'selected' : ''}} {{item.wrong ? 'wrong-record' : ''}}" data-action="studio-workshop-choose" data-value="{{item.id}}" bindtap="action" data-accepted="{{item.accepted}}" aria-pressed="{{item.selected}}" aria-label="{{item.label}}：{{item.caption}}"><image class="event-art" src="/illustrations/{{w.item.sourceArt.asset}}.jpg" mode="widthFix" aria-label="{{w.item.sourceArt.alt}}"/><text class="comparison-label">{{item.wrong ? '✕ ' : item.accepted ? '✓ ' : item.selected ? '● ' : ''}}{{item.label}}</text><text class="comparison-caption">{{item.caption}}</text></button></view><view wx:elif="{{w.item.sourceArt}}" class="event-art-wrap"><image class="event-art" src="/illustrations/{{w.item.sourceArt.asset}}.jpg" mode="widthFix" aria-label="{{w.item.sourceArt.alt}}"/><button wx:for="{{w.proofArtChoices}}" wx:key="id" class="art-panel-button {{item.selected || item.accepted ? 'selected' : ''}} {{item.wrong ? 'wrong-record' : ''}}" style="left:{{index*50}}%;width:50%;" data-action="studio-workshop-choose" data-value="{{item.id}}" bindtap="action" data-accepted="{{item.accepted}}" aria-pressed="{{item.selected}}"><text>{{item.wrong ? '✕ ' : item.accepted ? '✓ ' : item.selected ? '● ' : ''}}{{item.label}}</text></button></view><view wx:if="{{w.item.sourceOrder}}" class="source-order"><text class="field-label">我的顺序</text><text class="help">点原句放入顺序；点已放入的句子可撤下。</text><view class="source-order-answer {{w.correct ? 'order-correct' : ''}} {{w.orderSlots.length ? 'phase-order' : ''}}" aria-label="我的事件顺序"><block wx:if="{{w.orderSlots.length}}"><view wx:for="{{w.orderSlots}}" wx:for-item="slot" wx:key="label" class="phase-slot {{slot.filled ? 'phase-filled' : ''}} {{slot.wrong ? 'phase-wrong' : ''}} {{w.correct ? 'phase-verified' : ''}}"><text class="phase-label">{{slot.wrong ? '✕' : w.correct ? '✓' : slot.filled ? '●' : '○'}} {{slot.label}}</text><button wx:if="{{slot.filled}}" class="source-order-step {{slot.wrong ? 'order-wrong' : ''}}" data-action="studio-workshop-order-remove" data-value="{{slot.id}}" bindtap="action" aria-label="撤下{{slot.label}}：{{slot.text}}"><text class="phase-source-text">{{slot.text}}</text><text class="phase-remove" aria-hidden="true">点此撤下</text></button><text wx:else class="phase-empty">从下方选原句放入</text></view></block><block wx:else><button wx:for="{{w.orderAnswer}}" wx:for-item="orderCard" wx:key="id" class="source-order-step {{orderCard.wrong ? 'order-wrong' : ''}}" data-action="studio-workshop-order-remove" data-value="{{orderCard.id}}" bindtap="action" aria-label="撤下第{{index+1}}步：{{orderCard.text}}"><text class="reading-index">{{index+1}}</text><text>{{orderCard.text}}</text><text aria-hidden="true">撤下</text></button><text wx:if="{{!w.orderAnswer.length}}" class="source-order-empty">先选第一步</text></block></view><button class="button quiet" data-action="studio-workshop-order-clear" bindtap="action">重新排</button><view class="reading-evidence-list"><button wx:for="{{w.orderBank}}" wx:for-item="orderCard" wx:key="id" class="reading-evidence source-order-bank" data-action="studio-workshop-order-add" data-value="{{orderCard.id}}" disabled="{{orderCard.used}}" bindtap="action"><text class="reading-index">{{orderCard.used ? '已放' : '＋'}}</text><text>{{orderCard.text}}</text></button></view></view><block wx:else><text class="help">点原文卡片，找出能回答问题的依据。</text><view class="reading-evidence-list"><button wx:for="{{w.choices}}" wx:key="id" class="reading-evidence {{item.selected ? 'selected' : ''}} {{item.accepted ? 'accepted' : ''}} {{w.attempted && item.selected && !w.proofAccepted ? 'wrong-evidence' : ''}}" data-action="studio-workshop-choose" data-value="{{item.id}}" bindtap="action" aria-pressed="{{item.selected}}"><text class="reading-index">{{item.accepted ? '✓' : index+1}}</text><text>{{item.text}}</text></button></view></block></view>
    <text wx:if="{{w.proofRequired > 1 && !w.proofSteps.length && !w.item.sourceOrder}}" class="reading-progress">已找到 {{w.proofCollected.length}} / {{w.proofRequired}} 条关键线索</text><view wx:if="{{w.item.calculation && w.proofReady}}" class="reading-calculation"><text class="field-label">{{w.item.calculation.label}}</text><input class="input answer-input" data-name="studioWorkshopInput" value="{{w.input}}" type="text" maxlength="120" bindinput="input" aria-label="{{w.item.calculation.label}}"/><text class="help">{{w.item.calculation.hint}}</text></view><button class="button secondary" data-action="studio-workshop-check" bindtap="action">{{w.item.sourceOrder ? '检查我的顺序' : w.item.calculation && w.proofReady ? '核对我的计算' : '核对这条依据'}}</button><button class="button quiet" data-action="studio-workshop-source" bindtap="action">{{w.sourceOpen ? '收起全文' : '需要时看完整原文'}}</button><scroll-view wx:if="{{w.sourceOpen}}" scroll-y class="studio-reading"><text class="passage">{{w.item.material}}</text></scroll-view>
    <view wx:if="{{w.correct}}" class="reading-conclusion"><text class="field-label">根据线索得出</text><text>{{w.item.answer}}</text></view>
   </block>
   <block wx:else>   <view class="proof-chain"><view class="proof-node"><text class="proof-number">1</text><text class="field-label">题目要解决什么</text><text>{{w.item.prompt}}</text></view><view class="proof-arrow">↓</view><view class="proof-node proof-premise"><text class="proof-number">2</text><text class="field-label">把原文依据接进来</text><block wx:for="{{w.choices}}" wx:key="id"><text wx:if="{{item.selected && !(w.proofRequired > 1 && w.proofAccepted)}}">{{item.text}}</text></block><text wx:if="{{!w.selected}}">还没有选择依据</text><view wx:if="{{w.proofRequired > 1}}" class="proof-collected"><text class="field-label">已接上 {{w.proofCollected.length}} / {{w.proofRequired}} 条依据</text><text wx:for="{{w.proofCollected}}" wx:key="id">✓ {{item.text}}</text></view></view><view class="proof-arrow">↓</view><view class="proof-node {{w.correct ? 'proof-unlocked' : ''}}"><text class="proof-number">3</text><text class="field-label">{{w.correct ? '根据线索得出' : '结论还不能确定'}}</text><text wx:if="{{w.correct}}">{{w.item.answer}}</text><text wx:else class="proof-lock">?</text></view></view>
