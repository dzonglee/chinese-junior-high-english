== 'study' ? '●' : '✓'}} 看词表</text><text>{{w.recall.phase === 'study' ? '○' : w.recall.phase === 'recall' ? '●' : '✓'}} 遮住写</text><text>{{w.recall.phase === 'compare' ? '●' : '○'}} 对照差异</text></view><view wx:for="{{w.recall.rows}}" wx:for-item="recallRow" wx:key="id" class="recall-row"><text class="field-label">{{recallRow.cue}}</text><text wx:if="{{w.recall.phase === 'study'}}" class="recall-answer">{{recallRow.answer}}</text><block wx:else><input class="input" data-name="studioRecall-{{recallRow.id}}" value="{{recallRow.attempt}}" maxlength="80" bindinput="input" aria-label="凭记忆写：{{recallRow.cue}}"/><text wx:if="{{w.recall.phase === 'compare'}}" class="recall-comparison">{{recallRow.same ? '词形一致' : '核对差异'}} · 参考：{{recallRow.answer}}</text></block></view><button wx:if="{{w.recall.phase === 'study'}}" class="button secondary" data-action="studio-workshop-recall-hide" bindtap="action">遮住词表，试着回忆</button><block wx:elif="{{w.recall.phase === 'recall'}}"><text class="help">每格写下尝试；想不起来可写“不记得”。</text><button class="button secondary" data-action="studio-workshop-recall-reveal" disabled="{{!w.recall.ready}}" bindtap="action">揭开词表，对照差异</button><button class="button quiet" data-action="studio-workshop-recall-study" bindtap="action">再看一次词表</button></block><block wx:else><text class="help">保留刚才的尝试，找出要复习的词。修改任一格会重新遮住参考。</text><button class="button secondary" data-action="studio-workshop-recall-hide" bindtap="action">再遮住试一次</button><button class="button quiet" data-action="studio-workshop-recall-study" bindtap="action">重看词表</button></block></view><view wx:if="{{w.gap}}" class="cloze-context" aria-label="把词放回句子"><text class="field-label">我的试填</text><view class="gap-sentence"><text>{{w.gap.before}}</text><text class="gap-word {{w.gap.checked ? (w.gap.correct ? 'gap-correct' : 'gap-wrong') : ''}}">{{w.gap.text}}</text><text>{{w.gap.after}}</text></view><view wx:if="{{w.gap.map}}" class="location-map" aria-label="我的位置图" data-direction="{{w.gap.map.direction}}"><text class="field-label">我的位置图</text><text class="location-north" aria-label="地图北向">N ↑ 北</text><view class="location-map-grid"><view wx:for="{{w.gap.map.cells}}" wx:for-item="mapCell" wx:key="id" class="location-map-cell" data-slot="{{mapCell.id}}"><text wx:if="{{mapCell.text}}" class="location-map-label {{mapCell.anchor ? 'location-anchor' : 'location-marker'}} {{mapCell.marker && w.gap.checked ? (w.gap.correct ? 'location-correct' : 'location-wrong') : ''}}"><text wx:if="{{mapCell.anchor}}" class="location-village-symbol" aria-hidden="true">⌂</text>{{mapCell.text}}</text></view></view><text wx:if="{{!w.gap.map.ready}}" class="help">选一个方位，预览相对位置。</text><text class="help">箭头只表示北向。此图不显示水流、地形或距离。</text></view><view class="gap-options"><button wx:for="{{w.gap.options}}" wx:key="id" class="token {{item.selected ? 'selected' : ''}}" data-action="studio-workshop-gap" data-value="{{item.id}}" bindtap="action" aria-pressed="{{item.selected}}">{{item.text}}</button></view><button class="button secondary" data-action="studio-workshop-gap-check" bindtap="action">核对放回句子的意思</button><button class="button quiet" data-action="studio-workshop-gap" data-value="" bindtap="action">清空试填</button><text wx:if="{{w.gap.feedback}}" class="gap-feedback {{w.gap.correct ? 'correct' : ''}}">{{w.gap.feedback}}</text></view><view wx:if="{{w.item.sourceArt.layout === 'repeat'}}" class="event-art-wrap source-photo-comparison"><button wx:for="{{w.proofArtChoices}}" wx:key="id" class="art-panel-button {{item.selected || item.accepted ? 'selected' : ''}} {{item.wrong ? 'wrong-record' : ''}}" data-action="studio-workshop-choose" data-value="{{item.id}}" bindtap="action" data-accepted="{{item.accepted}}" aria-pressed="{{item.selected}}" aria-label="{{item.label}}：{{item.caption}}"><image class="event-art" src="/{{w.item.sourceArt.assetRoot || 'illustrations'}}/{{w.item.sourceArt.asset}}.jpg" mode="widthFix" aria-label="{{w.item.sourceArt.alt}}"/><text class="comparison-label">{{item.wrong ? '✕ ' : item.accepted ? '✓ ' : item.selected ? '● ' : ''}}{{item.label}}</text><text class="comparison-caption">{{item.caption}}</text></button></view><view wx:elif="{{w.item.sourceArt}}" class="event-art-wrap"><image class="event-art" src="/{{w.item.sourceArt.assetRoot || 'illustrations'}}/{{w.item.sourceArt.asset}}.jpg" mode="widthFix" aria-label="{{w.item.sourceArt.alt}}"/><button wx:for="{{w.proofArtChoices}}" wx:key="id" class="art-panel-button {{item.selected || item.accepted ? 'selected' : ''}} {{item.wrong ? 'wrong-record' : ''}}" style="left:{{index*50}}%;width:50%;" data-action="studio-workshop-choose" data-value="{{item.id}}" bindtap="action" data-accepted="{{item.accepted}}" aria-pressed="{{item.selected}}"><text>{{item.wrong ? '✕ ' : item.accepted ? '✓ ' : item.selected ? '● ' : ''}}{{item.label}}</text></button></view><view wx:if="{{w.item.sourceOrder}}" class="source-order"><text class="field-label">我的顺序</text><text class="help">点原句放入顺序；点已放入的句子可撤下。</text><view class="source-order-answer {{w.correct ? 'order-correct' : ''}} {{w.orderSlots.length ? 'phase-order' : ''}}" aria-label="我的事件顺序"><block wx:if="{{w.orderSlots.length}}"><view wx:for="{{w.orderSlots}}" wx:for-item="slot" wx:key="label" class="phase-slot {{slot.filled ? 'phase-filled' : ''}} {{slot.wrong ? 'phase-wrong' : ''}} {{w.correct ? 'phase-verified' : ''}}"><text class="phase-label">{{slot.wrong ? '✕' : w.correct ? '✓' : slot.filled ? '●' : '○'}} {{slot.label}}</text><button wx:if="{{slot.filled}}" class="source-order-step {{slot.wrong ? 'order-wrong' : ''}}" data-action="studio-workshop-order-remove" data-value="{{slot.id}}" bindtap="action" aria-label="撤下{{slot.label}}：{{slot.text}}"><text class="phase-source-text">{{slot.text}}</text><text class="phase-remove" aria-hidden="true">点此撤下</text></button><text wx:else class="phase-empty">从下方选原句放入</text></view></block><block wx:else><button wx:for="{{w.orderAnswer}}" wx:for-item="orderCard" wx:key="id" class="source-order-step {{orderCard.wrong ? 'order-wrong' : ''}}" data-action="studio-workshop-order-remove" data-value="{{orderCard.id}}" bindtap="action" aria-label="撤下第{{index+1}}步：{{orderCard.text}}"><text class="reading-index">{{index+1}}</text><text>{{orderCard.text}}</text><text aria-hidden="true">撤下</text></button><text wx:if="{{!w.orderAnswer.length}}" class="source-order-empty">先选第一步</text></block></view><button class="button quiet" data-action="studio-workshop-order-clear" bindtap="action">重新排</button><view class="reading-evidence-list"><button wx:for="{{w.orderBank}}" wx:for-item="orderCard" wx:key="id" class="reading-evidence source-order-bank" data-action="studio-workshop-order-add" data-value="{{orderCard.id}}" disabled="{{orderCard.used}}" bindtap="action"><text class="reading-index">{{orderCard.used ? '已放' : '＋'}}</text><text>{{orderCard.text}}</text></button></view></view><block wx:else><text class="help">点原文卡片，找出能回答问题的依据。</text><view class="reading-evidence-list"><button wx:for="{{w.choices}}" wx:key="id" class="reading-evidence {{item.selected ? 'selected' : ''}} {{item.accepted ? 'accepted' : ''}} {{w.attempted && item.selected && !w.proofAccepted ? 'wrong-evidence' : ''}}" data-action="studio-workshop-choose" data-value="{{item.id}}" bindtap="action" aria-pressed="{{item.selected}}"><text class="reading-index">{{item.accepted ? '✓' : index+1}}</text><text>{{item.text}}</text></button></view></block></view>
    <text wx:if="{{w.proofRequired > 1 && !w.proofSteps.length && !w.item.sourceOrder}}" class="reading-progress">已找到 {{w.proofCollected.length}} / {{w.proofRequired}} 条关键线索</text><view wx:if="{{w.item.calculation && w.proofReady}}" class="reading-calculation"><view wx:if="{{w.reduction}}" class="reduction-model {{w.attempted ? (w.correct ? 'reduction-right' : 'reduction-wrong') : ''}}" aria-label="数量与我的减少量"><text class="help">条形长度共用同一刻度；第三行只画你输入的减少量。</text><view wx:for="{{w.reduction.rows}}" wx:for-item="row" wx:key="id" class="reduction-row" data-count="{{row.id}}"><view class="reduction-label"><text>{{row.label}}</text><text>{{row.value}} {{w.reduction.unit}}</text></view><view class="reduction-track"><view class="reduction-bar {{row.id === 'attempt' ? 'reduction-attempt' : ''}}" style="width:{{row.width}}%;"></view></view></view></view><text class="field-label">{{w.item.calculation.label}}</text><input class="input answer-input" data-name="studioWorkshopInput" value="{{w.input}}" type="{{w.item.calculation.kind === 'time' ? 'text' : 'number'}}" maxlength="120" bindinput="input" aria-label="{{w.item.calculation.label}}"/><text class="help">{{w.item.calculation.hint}}</text></view><button class="button secondary" data-action="studio-workshop-check" bindtap="action">{{w.item.sourceOrder ? '检查我的顺序' : w.item.calculation && w.proofReady ? '核对我的计算' : '核对这条依据'}}</button><button class="button quiet" data-action="studio-workshop-source" bindtap="action">{{w.sourceOpen ? '收起全文' : '需要时看完整原文'}}</button><scroll-view wx:if="{{w.sourceOpen}}" scroll-y class="studio-reading"><text class="passage">{{w.item.material}}</text></scroll-view>
    <view wx:if="{{w.correct}}" class="reading-conclusion"><text class="field-label">根据线索得出</text><text>{{w.item.answer}}</text></view>
   </block>
   <block wx:else>   <view class="proof-chain"><view class="proof-node"><text class="proof-number">1</text><text class="field-label">题目要解决什么</text><text>{{w.item.prompt}}</text></view><view class="proof-arrow">↓</view><view class="proof-node proof-premise"><text class="proof-number">2</text><text class="field-label">把原文依据接进来</text><block wx:for="{{w.choices}}" wx:key="id"><text wx:if="{{item.selected && !(w.proofRequired > 1 && w.proofAccepted)}}">{{item.text}}</text></block><text wx:if="{{!w.selected}}">还没有选择依据</text><view wx:if="{{w.proofRequired > 1}}" class="proof-collected"><text class="field-label">已接上 {{w.proofCollected.length}} / {{w.proofRequired}} 条依据</text><text wx:for="{{w.proofCollected}}" wx:key="id">✓ {{item.text}}</text></view></view><view class="proof-arrow">↓</view><view class="proof-node {{w.correct ? 'proof-unlocked' : ''}}"><text class="proof-number">3</text><text class="field-label">{{w.correct ? '根据线索得出' : '结论还不能确定'}}</text><text wx:if="{{w.correct}}">{{w.item.answer}}</text><text wx:else class="proof-lock">?</text></view></view>
   <button class="button quiet" data-action="studio-workshop-source" bindtap="action">{{w.sourceOpen ? '收起全文' : '打开完整材料'}}</button><scroll-view wx:if="{{w.sourceOpen}}" scroll-y class="studio-reading"><text class="passage">{{w.item.material}}</text></scroll-view><text class="field-label">点编号，逐句读；上方会显示你选的原句</text><view class="proof-sources"><button wx:for="{{w.choices}}" wx:key="id" class="chip {{item.selected ? 'selected' : ''}}" data-action="studio-workshop-choose" data-value="{{item.id}}" bindtap="action">{{item.accepted ? '✓ ' : ''}}{{index+1}}</button></view><button class="button secondary" data-action="studio-workshop-check" bindtap="action">检查这条推理链</button><block wx:if="{{w.correct}}"><text class="field-label">线索怎样回答问题？写一句自己的推理</text><textarea class="input textarea" data-name="studioWorkshopOwn" value="{{w.own}}" bindinput="input" maxlength="1000"/><text class="help">中文或英文都可以。这里只保存推理，不自动评分。</text><button class="button secondary" data-action="studio-workshop-save" bindtap="action">保存我的推理</button></block></block>
   <block wx:if="{{w.item.sourceStyle === 'cards' && w.correct && (w.proofRequired > 1 || w.gap)}}"><text class="field-label">{{w.gap ? '为什么这个词合适？写出上下文线索' : w.item.sourceOrder ? '为什么这样排？写一句自己的推理' : '线索怎样回答问题？写一句自己的推理'}}</text><textarea class="input textarea" data-name="studioWorkshopOwn" value="{{w.own}}" bindinput="input" maxlength="1000"/><text class="help">中文或英文均可。这里只保存推理，不自动评分。</text><button class="button secondary" data-action="studio-workshop-save" bindtap="action">保存我的推理</button></block>
  </block>
  <block wx:elif="{{w.kind === 'compose'}}"><button class="button quiet" data-action="studio-workshop-source" bindtap="action">{{w.sourceOpen ? '收起任务' : '对照完整任务'}}</button><scroll-view wx:if="{{w.sourceOpen}}" scroll-y class="studio-reading"><text class="passage">{{w.item.material}}</text></scroll-view><view class="compose-task"><text class="eyebrow">写作计划 {{w.index+1}}</text><text class="section-title">{{w.item.label}}</text></view><text class="field-label">先写我自己的说法</text><textarea class="input textarea" data-name="studioWorkshopOwn" value="{{w.own}}" bindinput="input" maxlength="1000"/><text class="help">{{w.draftWords}} 个英文词 · 至少4个英文词，写一个具体细节。这里只记录计划，不自动判断内容是否完整。</text><button class="button secondary" data-action="studio-workshop-check" bindtap="action">把这句放进我的计划</button></block>
  <block wx:else><text class="section-title">{{w.item.prompt}}</text><view class="sound-workbench"><text class="sound-original">{{w.item.before}}</text><text class="world-connector">↓</text><view wx:if="{{w.soundUnits.length}}" class="sound-units sound-{{w.soundMode}}"><text wx:for="{{w.soundUnits}}" wx:key="index" class="sound-unit {{item.emphasis ? 'emphasised' : ''}}">{{item.text}}</text></view><block wx:else><block wx:for="{{w.choices}}" wx:key="id"><text wx:if="{{item.selected}}">{{item.text}}</text></block></block><view wx:if="{{w.pitch}}" class="pitch-diagram"><view class="pitch-line pitch-{{w.pitch}}"/></view></view><view class="tokens"><button wx:for="{{w.choices}}" wx:key="id" class="token {{item.selected ? 'selected' : ''}}" data-action="studio-workshop-choose" data-value="{{item.id}}" bindtap="action">{{item.text}}</button></view><button class="button secondary" data-action="studio-workshop-check" bindtap="action">核对标记和意思</button></block>
  <text wx:if="{{w.feedback}}" class="explore-feedback {{!w.ownMissing && (w.correct || (w.kind === 'proof' && w.proofAccepted && !w.item.calculation)) ? 'correct' : ''}}">{{w.feedback}}</text><text wx:if="{{w.complete}}" class="workshop-saved">✓ 这一项已记录。换一个条件或任务继续。</text>
 </view>
</template>
