   <block wx:if="{{w.item.sourceStyle === 'cards' && w.correct && w.proofRequired > 1}}"><text class="field-label">{{w.item.sourceOrder ? '为什么这样排？写一句自己的推理' : '线索怎样回答问题？写一句自己的推理'}}</text><textarea class="input textarea" data-name="studioWorkshopOwn" value="{{w.own}}" bindinput="input" maxlength="1000"/><text class="help">中文或英文均可。这里只保存推理，不自动评分。</text><button class="button secondary" data-action="studio-workshop-save" bindtap="action">保存我的推理</button></block>
  </block>
  <block wx:elif="{{w.kind === 'compose'}}"><button class="button quiet" data-action="studio-workshop-source" bindtap="action">{{w.sourceOpen ? '收起任务' : '对照完整任务'}}</button><scroll-view wx:if="{{w.sourceOpen}}" scroll-y class="studio-reading"><text class="passage">{{w.item.material}}</text></scroll-view><view class="compose-task"><text class="eyebrow">写作计划 {{w.index+1}}</text><text class="section-title">{{w.item.label}}</text></view><text class="field-label">先写我自己的说法</text><textarea class="input textarea" data-name="studioWorkshopOwn" value="{{w.own}}" bindinput="input" maxlength="1000"/><text class="help">{{w.draftWords}} 个英文词 · 至少4个英文词，写一个具体细节。这里只记录计划，不自动判断内容是否完整。</text><button class="button secondary" data-action="studio-workshop-check" bindtap="action">把这句放进我的计划</button></block>
  <block wx:else><text class="section-title">{{w.item.prompt}}</text><view class="sound-workbench"><text class="sound-original">{{w.item.before}}</text><text class="world-connector">↓</text><view wx:if="{{w.soundUnits.length}}" class="sound-units sound-{{w.soundMode}}"><text wx:for="{{w.soundUnits}}" wx:key="index" class="sound-unit {{item.emphasis ? 'emphasised' : ''}}">{{item.text}}</text></view><block wx:else wx:for="{{w.choices}}" wx:key="id"><text wx:if="{{item.selected}}">{{item.text}}</text></block><view wx:if="{{w.pitch}}" class="pitch-diagram"><view class="pitch-line pitch-{{w.pitch}}"/></view></view><view class="tokens"><button wx:for="{{w.choices}}" wx:key="id" class="token {{item.selected ? 'selected' : ''}}" data-action="studio-workshop-choose" data-value="{{item.id}}" bindtap="action">{{item.text}}</button></view><button class="button secondary" data-action="studio-workshop-check" bindtap="action">核对标记和意思</button></block>
