<template name="lesson-workshop">
 <view class="lesson-workshop">
  <text class="eyebrow">动手任务 · {{w.doneCount}} / {{w.total}}</text><text class="section-title">{{w.title}}</text><text class="help">{{w.instruction}}</text>
  <view class="workshop-tabs"><button wx:for="{{w.tabs}}" wx:key="id" class="chip {{w.index == item.id ? 'selected' : ''}}" data-action="studio-workshop-item" data-value="{{item.id}}" bindtap="action">{{item.done ? '✓ ' : ''}}{{item.label}}</button></view>
  <block wx:if="{{w.kind === 'transform'}}">
   <view class="workshop-world world-{{w.worldClass}}"><text class="world-caption">{{w.condition.world.caption}}</text>
    <view wx:if="{{w.worldClass === 'position'}}" class="position-room"><text class="position-table">desk</text><text class="position-book" style="top:{{w.cells[0].value}}%;">book</text></view>
    <view wx:elif="{{w.worldClass === 'timeline'}}" class="time-world"><view class="time-axis"><text>过去</text><text class="axis-now">现在</text><text>将来 →</text></view><block wx:for="{{w.cells}}" wx:key="index"><view class="time-track"><view class="time-now"/><view wx:if="{{item.role}}" class="time-range range-{{item.role}}"/><view class="time-event" style="{{item.style}}"><view class="time-dot"/><text>{{item.label}}</text></view></view><text class="time-note">{{item.detail}}</text></block></view>
    <view wx:else class="world-cells"><block wx:for="{{w.cells}}" wx:key="index" wx:for-item="cell"><text wx:if="{{index > 0 && (w.worldClass === 'roles' || w.worldClass === 'logic' || w.worldClass === 'morphology')}}" class="world-connector">{{w.worldClass === 'morphology' ? (index === 1 ? '+' : '=') : '→'}}</text><view class="world-cell {{cell.role === 'subject' ? 'world-subject' : ''}}"><view wx:if="{{w.worldClass === 'count'}}" class="count-objects"><view wx:for="{{cell.copies}}" wx:key="*this" class="count-object count-{{cell.art}}"><text wx:if="{{cell.art === 'bundle'}}">100</text></view><text wx:if="{{cell.uncertain}}">…</text></view><view wx:if="{{w.worldClass === 'scale'}}" class="scale-rail"><view class="scale-fill" style="width:{{cell.value}}%;"/></view><text class="world-label">{{cell.label}}</text><text class="world-detail">{{cell.detail}}</text></view></block></view>
   </view><text class="field-label">让句子符合当前条件：{{w.condition.label}}</text><view class="workshop-sentence {{w.attempted && !w.correct ? 'needs-repair' : ''}}"><text>{{w.condition.before}}</text><text class="workshop-slot">{{w.selected || '…'}}</text><text>{{w.condition.after}}</text></view>
   <view class="tokens"><button wx:for="{{w.choices}}" wx:key="id" class="token {{item.selected ? 'selected' : ''}}" data-action="studio-workshop-choose" data-value="{{item.id}}" bindtap="action">{{item.text}}</button></view><button class="button secondary" data-action="studio-workshop-check" bindtap="action">核对句子与条件</button>
  </block>
  <block wx:elif="{{w.kind === 'word-use'}}">
   <view wx:if="{{w.item.usage}}" class="usage-world"><text class="help">{{w.item.usage.caption}}</text><view class="usage-people"><text>{{w.item.usage.left}}</text><text>{{w.item.usage.right}}</text></view><view class="usage-track"><text class="usage-arrow">{{w.usageDirection === 'left' ? '←' : w.usageDirection === 'right' ? '→' : '?'}}</text><text class="usage-object object-{{w.usageDirection || 'rest'}}">{{w.item.usage.object}}</text></view><text class="help">方向跟着你输入的词变化；再核对它是否符合情境。</text></view><view class="word-meaning"><text class="eyebrow">从意思到用法</text><text class="section-title">{{w.item.meaning}}</text></view><view class="workshop-sentence"><text>{{w.item.before}}</text><text class="workshop-slot">{{w.input || '…'}}</text><text>{{w.item.after}}</text></view><text class="help">{{w.item.hint}}</text><text class="field-label">遮住词表，自己写</text><input class="input answer-input" data-name="studioWorkshopInput" value="{{w.input}}" bindinput="input" maxlength="120"/>
   <button class="button secondary" data-action="studio-workshop-check" bindtap="action">核对词形</button><button class="button quiet" data-action="studio-workshop-reveal" bindtap="action">{{w.revealed ? '遮住参考' : '需要时看参考'}}</button><view wx:if="{{w.revealed}}" class="workshop-reference"><text class="section-title">{{w.item.answer}}</text><text>{{w.item.material}}</text><text class="help">{{w.item.reason}}</text></view>
   <block wx:if="{{w.correct}}"><text class="field-label">换成我的生活：用这个词写一句</text><textarea class="input textarea" data-name="studioWorkshopOwn" value="{{w.own}}" bindinput="input" maxlength="1000"/><text class="help">{{w.draftWords}} 个英文词 · 核对词义和搭配。机器只检查词形和长度。</text><button class="button secondary" data-action="studio-workshop-save" bindtap="action">保存例句与自查</button></block>
  </block>
  <block wx:elif="{{w.kind === 'proof'}}">
   <view class="proof-chain"><view class="proof-node"><text class="proof-number">1</text><text class="field-label">题目要解决什么</text><text>{{w.item.prompt}}</text></view><view class="proof-arrow">↓</view><view class="proof-node proof-premise"><text class="proof-number">2</text><text class="field-label">把原文依据接进来</text><block wx:for="{{w.choices}}" wx:key="id"><text wx:if="{{item.selected && !(w.proofRequired > 1 && w.proofAccepted)}}">{{item.text}}</text></block><text wx:if="{{!w.selected}}">还没有选择依据</text><view wx:if="{{w.proofRequired > 1}}" class="proof-collected"><text class="field-label">已接上 {{w.proofCollected.length}} / {{w.proofRequired}} 条依据</text><text wx:for="{{w.proofCollected}}" wx:key="id">✓ {{item.text}}</text></view></view><view class="proof-arrow">↓</view><view class="proof-node {{w.correct ? 'proof-unlocked' : ''}}"><text class="proof-number">3</text><text class="field-label">{{w.correct ? '根据依据得出' : '结论还不能确定'}}</text><text wx:if="{{w.correct}}">{{w.item.answer}}</text><text wx:else class="proof-lock">?</text></view></view>
   <button class="button quiet" data-action="studio-workshop-source" bindtap="action">{{w.sourceOpen ? '收起全文' : '打开完整材料'}}</button><scroll-view wx:if="{{w.sourceOpen}}" scroll-y class="studio-reading"><text class="passage">{{w.item.material}}</text></scroll-view><text class="field-label">点编号，逐句读；上方会显示你选的原句</text><view class="proof-sources"><button wx:for="{{w.choices}}" wx:key="id" class="chip {{item.selected ? 'selected' : ''}}" data-action="studio-workshop-choose" data-value="{{item.id}}" bindtap="action">{{item.accepted ? '✓ ' : ''}}{{index+1}}</button></view><button class="button secondary" data-action="studio-workshop-check" bindtap="action">检查这条推理链</button><block wx:if="{{w.correct}}"><text class="field-label">线索怎样回答问题？写一句自己的推理</text><textarea class="input textarea" data-name="studioWorkshopOwn" value="{{w.own}}" bindinput="input" maxlength="1000"/><text class="help">中文或英文都可以。这里只保存推理，不自动评分。</text><button class="button secondary" data-action="studio-workshop-save" bindtap="action">保存我的推理</button></block>
  </block>
  <block wx:elif="{{w.kind === 'compose'}}"><button class="button quiet" data-action="studio-workshop-source" bindtap="action">{{w.sourceOpen ? '收起任务' : '对照完整任务'}}</button><scroll-view wx:if="{{w.sourceOpen}}" scroll-y class="studio-reading"><text class="passage">{{w.item.material}}</text></scroll-view><view class="compose-task"><text class="eyebrow">写作计划 {{w.index+1}}</text><text class="section-title">{{w.item.label}}</text></view><text class="field-label">先写我自己的说法</text><textarea class="input textarea" data-name="studioWorkshopOwn" value="{{w.own}}" bindinput="input" maxlength="1000"/><text class="help">{{w.draftWords}} 个英文词 · 至少4个英文词，写一个具体细节。这里只记录计划，不自动判断内容是否完整。</text><button class="button secondary" data-action="studio-workshop-check" bindtap="action">把这句放进我的计划</button></block>
  <block wx:else><text class="section-title">{{w.item.prompt}}</text><view class="sound-workbench"><text class="sound-original">{{w.item.before}}</text><text class="world-connector">↓</text><view wx:if="{{w.soundUnits.length}}" class="sound-units sound-{{w.soundMode}}"><text wx:for="{{w.soundUnits}}" wx:key="index" class="sound-unit {{item.emphasis ? 'emphasised' : ''}}">{{item.text}}</text></view><block wx:else wx:for="{{w.choices}}" wx:key="id"><text wx:if="{{item.selected}}">{{item.text}}</text></block><view wx:if="{{w.pitch}}" class="pitch-diagram"><view class="pitch-line pitch-{{w.pitch}}"/></view></view><view class="tokens"><button wx:for="{{w.choices}}" wx:key="id" class="token {{item.selected ? 'selected' : ''}}" data-action="studio-workshop-choose" data-value="{{item.id}}" bindtap="action">{{item.text}}</button></view><button class="button secondary" data-action="studio-workshop-check" bindtap="action">核对标记和意思</button></block>
  <text wx:if="{{w.feedback}}" class="explore-feedback {{w.correct || (w.kind === 'proof' && w.proofAccepted) ? 'correct' : ''}}">{{w.feedback}}</text><text wx:if="{{w.complete}}" class="workshop-saved">✓ 这一项已记录。换一个条件或任务继续。</text>
 </view>
</template>
