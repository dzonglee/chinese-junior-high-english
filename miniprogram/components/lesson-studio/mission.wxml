<template name="visual-mission">
<view wx:if="{{m.lab.open}}" class="visual-mission mission-lab"><text class="mission-badge">换条件，看变化</text><text class="mission-title">{{m.lab.title}}</text><text class="help mission-instruction">点下面两个条件，观察句子中高亮的部分怎样变化。</text><view class="lab-switch"><button wx:for="{{m.lab.states}}" wx:key="index" class="lab-condition {{m.lab.index === index ? 'selected' : ''}}" data-action="studio-mission-lab" data-value="{{index}}" bindtap="action">{{item.label}}</button></view><view class="live-language"><text class="live-input">{{m.lab.states[m.lab.index].label}}</text><text class="lab-arrow">↓</text><view class="live-sentence"><text>{{m.lab.before}}</text><text class="live-focus">{{m.lab.focus}}</text><text>{{m.lab.after}}</text></view></view><text class="lab-discovery">{{m.lab.note}}</text><button class="button primary" data-action="studio-mission-lab-pane" bindtap="action">我看懂了，去修一句</button></view>
<view wx:else class="visual-mission mission-{{m.board.kind}}">
 <view wx:if="{{m.art}}" class="mission-scene"><image src="{{'/assets/'+m.art+'.jpg'}}" mode="aspectFill"/><text class="scene-caption">把英语用起来</text></view>
 <view class="mission-topline"><text class="mission-badge">{{m.board.kind === 'context' ? '词卡连线' : m.board.kind === 'repair' ? '修句工坊' : m.board.kind === 'evidence' ? '证据侦探' : m.board.kind === 'storyboard' ? '表达分镜' : '规律分类'}}</text><text>{{m.index+1}} / {{m.total}} 组</text></view>
 <text class="mission-title">{{m.board.title}}</text><text class="help mission-instruction">{{m.board.instruction}}</text>
 <view class="mission-board-tabs"><button wx:for="{{view.lesson.mission.boards}}" wx:key="id" class="mission-dot {{m.index === index ? 'current' : ''}}" data-action="studio-mission-board" data-value="{{index}}" bindtap="action">{{m.doneBoards[index] ? '✓ ' : ''}}{{index+1}}</button></view>
 <view class="mission-dock"><button wx:for="{{m.slots}}" wx:key="id" class="mission-port {{item.selected ? 'active' : ''}} {{item.done ? 'done' : ''}}" data-action="studio-mission-slot" data-value="{{item.id}}" bindtap="action">{{item.done ? '✓' : index+1}} {{item.label}}</button></view>
 <view class="mission-canvas diagram-{{m.board.diagram}}"><text class="mission-canvas-label">{{m.board.kind === 'storyboard' ? '这一幕说了什么' : m.board.kind === 'evidence' ? '先锁定问题' : m.board.kind === 'repair' ? '试着修好这句' : m.board.kind === 'sound' ? '观察这个例子' : '让句意完整'}}</text><text wx:if="{{m.goal}}" class="mission-goal">{{m.goal}}</text><text class="mission-context">{{m.nativeContext}}</text><view wx:if="{{m.pitch}}" class="pitch-diagram"><view class="pitch-line pitch-{{m.pitch}}"/></view>
  <view wx:if="{{m.board.kind === 'repair'}}" class="repair-original"><text>当前表达</text><text class="repair-word {{m.correct ? 'fixed' : ''}}">{{m.slots[0].placed || m.active.initial}}</text></view>
  <view class="mission-link"><text class="link-node">{{m.board.kind === 'evidence' ? '问题' : m.board.kind === 'storyboard' ? '一句表达' : '语境'}}</text><view class="link-thread"/><text class="link-node {{m.correct ? 'solved' : ''}}">{{!m.recall && m.activePlaced ? m.activePlaced : '?'}}</text><block wx:if="{{m.board.kind === 'evidence'}}"><view class="link-thread"/><text class="link-node {{m.correct ? 'solved' : ''}}">{{m.activeDone ? m.board.conclusion : '结论待解锁'}}</text></block></view>
 </view>
 <view class="mission-tools"><button class="mission-tool" data-action="studio-mission-hint" bindtap="action">{{m.hint ? '收起提示' : '给我一条线索'}}</button><button wx:if="{{m.board.material}}" class="mission-tool" data-action="studio-mission-material" bindtap="action">{{m.materialOpen ? '收起材料' : '打开任务材料'}}</button></view>
 <text wx:if="{{m.hint}}" class="mission-hint">{{m.active.hint}}</text><scroll-view wx:if="{{m.materialOpen}}" scroll-y class="mission-material"><text class="passage">{{m.board.material}}</text></scroll-view>
 <text class="mission-bank-label">{{m.board.kind === 'storyboard' ? '选择这句承担的任务' : m.board.kind === 'evidence' ? '把原文线索接进来' : m.board.kind === 'sound' ? '送进对应分类' : '点一张卡，放进当前空位'}}</text>
 <view wx:if="{{!m.recall}}" class="mission-bank"><button wx:for="{{m.chips}}" wx:key="id" class="mission-chip {{item.selected ? 'placed' : ''}} {{m.board.kind === 'evidence' ? 'evidence-card' : ''}}" data-action="studio-mission-place" data-value="{{item.id}}" disabled="{{item.used || busy}}" bindtap="action">{{item.text}}</button></view>
 <block wx:if="{{m.board.kind === 'context'}}"><button class="mission-tool" data-action="studio-mission-recall" bindtap="action">{{m.recall ? '返回词卡' : '遮住词卡，自己拼一次'}}</button><block wx:if="{{m.recall}}"><input class="input mission-recall" value="{{m.recallValue}}" data-name="studioMissionRecall" bindinput="input" maxlength="100" placeholder="遮住词卡后的拼写"/><button class="button secondary" data-action="studio-mission-recall-check" bindtap="action">核对拼写</button><text wx:if="{{m.recallChecked}}" class="mission-feedback {{m.recallCorrect ? 'correct' : ''}}">{{m.recallCorrect ? '这次拼对了。' : '还没拼对。可以再试一次，或回词卡核对。'}}</text></block></block>
 <view wx:if="{{m.board.kind === 'storyboard'}}" class="mission-own"><text class="field-label">换成我的说法</text><text class="help">保留这句的作用，换一个自己的细节。这里只保存草稿，不自动评分。</text><textarea class="input textarea" value="{{m.ownLine}}" data-name="studioMissionOwn" bindinput="input" maxlength="1000" placeholder="这个分镜的原创表达"/></view>
 <view wx:if="{{m.feedback && !m.recall}}" class="mission-feedback {{m.correct ? 'correct' : ''}}"><text class="feedback-symbol">{{m.correct ? '✓' : '↻'}}</text><text>{{m.feedback}}</text></view>
 <text wx:if="{{m.boardDone}}" class="mission-success">✓ 这一组已完成。可以继续，也可以点已完成的卡片再看一遍。</text>
</view>
</template>
