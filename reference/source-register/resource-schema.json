{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resource-schema.json",
  "title": "Stage 1 research register (初中英语)",
  "description": "Empty values mean unknown, never inferred false. Every unit folder holds sources.json (an array of source), download_manifest.json (an array of file), coverage.json (an array of coverage_cell) and research.md.",
  "version": "1.0",
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "source_id",
        "title",
        "url",
        "publisher",
        "retrieval_date",
        "jurisdiction",
        "cities",
        "years",
        "grades",
        "resource_type",
        "format",
        "authority",
        "verification",
        "download_status",
        "rights",
        "commercial_reuse_approved"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^R-[A-Z0-9-]+::\\d{3,}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "publication_date": {
          "type": "string"
        },
        "retrieval_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "jurisdiction": {
          "type": "string",
          "description": "Who the source speaks for, as reported: 广东省, 广州市, 某区, 某校."
        },
        "cities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "city_id values from cities/roster.json that the source explicitly names."
        },
        "years": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "grades": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "cohort": {
          "type": "string",
          "description": "Which entry/exam cohort a fact applies to, e.g. 2027届, 2024级起."
        },
        "resource_type": {
          "enum": [
            "curriculum_standard",
            "standard_appendix",
            "textbook",
            "textbook_catalogue",
            "edition_adoption",
            "exam_paper",
            "answer_key",
            "listening_audio",
            "listening_transcript",
            "speaking_spec",
            "speaking_sample",
            "exam_policy",
            "exam_syllabus",
            "vocabulary_list",
            "writing_rubric",
            "model_essay",
            "level_measurement",
            "rights_terms",
            "practice_system",
            "news_report",
            "term_paper",
            "mock_paper",
            "question_bank",
            "topic_collection",
            "commercial_bank_index",
            "workbook",
            "teacher_guide",
            "unit_test",
            "review_book",
            "grammar_reference",
            "vocabulary_book",
            "teaching_schedule",
            "graded_reader",
            "reading_list",
            "exam_analysis",
            "essay_collection",
            "other"
          ]
        },
        "format": {
          "type": "string"
        },
        "authority": {
          "enum": [
            "official_exam_authority",
            "official_education_department",
            "official_school",
            "publisher",
            "commercial_bank",
            "commercial_aggregator",
            "community",
            "unknown"
          ]
        },
        "verification": {
          "enum": [
            "verified_original_document",
            "verified_official_page",
            "mirror_matches_official",
            "indexed_preview_only",
            "recollection_or_compilation",
            "untrusted_candidate",
            "failed"
          ]
        },
        "download_status": {
          "enum": [
            "downloaded_sha256_verified",
            "reference_only",
            "preview_link_only",
            "paywall_or_registration_not_bypassed",
            "blocked",
            "not_found"
          ]
        },
        "rights": {
          "enum": [
            "unknown",
            "reference_only",
            "public_policy_document",
            "explicit_permission",
            "commercial_licence",
            "open_licence"
          ]
        },
        "commercial_reuse_approved": {
          "const": false,
          "description": "Always false in Stage 1. Only the owner records permission."
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Short facts quoted or paraphrased from the source, with page/section."
        },
        "caveats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "related_source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "series": {
          "type": "string",
          "description": "For 教辅, banks and mocks: the series or platform name."
        }
      }
    },
    "file": {
      "type": "object",
      "required": [
        "file_id",
        "source_id",
        "download_url",
        "relative_path",
        "retrieved",
        "bytes",
        "sha256",
        "opened_check"
      ],
      "properties": {
        "file_id": {
          "type": "string",
          "pattern": "^R-[A-Z0-9-]+-\\d{3,}$"
        },
        "source_id": {
          "type": "string"
        },
        "download_url": {
          "type": "string"
        },
        "relative_path": {
          "type": "string",
          "description": "Path under reference/, e.g. files/south/广州-2025-paper.pdf"
        },
        "retrieved": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "opened_check": {
          "type": "string",
          "minLength": 10,
          "description": "What you saw when opening it: city, year, subject, paper/answers/audio, complete or partial, pages/duration."
        }
      }
    },
    "coverage_cell": {
      "type": "object",
      "required": [
        "city_id",
        "year",
        "resource",
        "status"
      ],
      "properties": {
        "city_id": {
          "type": "string"
        },
        "year": {
          "type": "integer"
        },
        "resource": {
          "enum": [
            "exam_structure",
            "exam_paper",
            "answer_key",
            "listening_audio",
            "listening_transcript",
            "speaking_spec",
            "exam_syllabus",
            "vocabulary_list",
            "writing_rubric",
            "edition_adoption",
            "term_paper",
            "mock_paper",
            "teaching_schedule",
            "question_bank"
          ]
        },
        "status": {
          "enum": [
            "not_searched",
            "not_found",
            "blocked",
            "link_only",
            "file_reported",
            "file_verified",
            "licensed_ingestion_ready"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        },
        "grade": {
          "type": "integer",
          "description": "For term papers and mocks: 7, 8 or 9."
        },
        "term": {
          "enum": [
            "upper",
            "lower"
          ],
          "description": "For term papers: 上学期 upper, 下学期 lower."
        },
        "kind": {
          "type": "string",
          "description": "For term papers and mocks: 月考 / 期中 / 期末 / 一模 / 二模 / 三模 / 适应性."
        }
      }
    }
  }
}