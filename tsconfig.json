{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["miniprogram-api-typings"]
  },
  "include": ["src/**/*.ts", "miniprogram/**/*.ts", "web/**/*.ts"],
  "exclude": ["node_modules", "miniprogram/data/generated", "src/**/*.test.ts"]
}
